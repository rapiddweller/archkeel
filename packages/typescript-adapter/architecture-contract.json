{
  "$schema": "https://raw.githubusercontent.com/rapiddweller/archkeel/main/schema/architecture-contract.schema.json",
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "COMP-ENTRY",
      "label": "entry",
      "role": "component",
      "packages": [],
      "exact_modules": [
        "archkeel.typescript.src.entry_x2e_ts"
      ],
      "public": [],
      "requires": [
        {
          "component": "collect",
          "through": [
            "archkeel.typescript.src.collect_x2e_ts"
          ],
          "rationale": "Keep process I/O outside AST collection."
        },
        {
          "component": "protocol",
          "through": [
            "archkeel.typescript.src.protocol_x2e_ts"
          ],
          "rationale": "Validate the request before accessing project files."
        }
      ],
      "responsibilities": [
        "Read one JSON request, run collection and write one JSON response."
      ],
      "forbidden_responsibilities": [
        "Project resolution, AST traversal and architecture decisions."
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMP-COLLECT",
      "label": "collect",
      "role": "component",
      "packages": [],
      "exact_modules": [
        "archkeel.typescript.src.collect_x2e_ts"
      ],
      "public": [
        "archkeel.typescript.src.collect_x2e_ts"
      ],
      "requires": [
        {
          "component": "project",
          "through": [
            "archkeel.typescript.src.project_x2e_ts"
          ],
          "rationale": "Use one contained resolver for source selection and import targets."
        },
        {
          "component": "protocol",
          "through": [
            "archkeel.typescript.src.protocol_x2e_ts"
          ],
          "rationale": "Emit imports and evidence through shared source-fact records."
        }
      ],
      "responsibilities": [
        "Extract import facts and evidence from the TypeScript AST."
      ],
      "forbidden_responsibilities": [
        "Architecture rules, measurements and executing scanned code."
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMP-PROJECT",
      "label": "project",
      "role": "component",
      "packages": [],
      "exact_modules": [
        "archkeel.typescript.src.project_x2e_ts"
      ],
      "public": [
        "archkeel.typescript.src.project_x2e_ts"
      ],
      "requires": [
        {
          "component": "protocol",
          "through": [
            "archkeel.typescript.src.protocol_x2e_ts"
          ],
          "rationale": "Use the validated request scope and stable input digests."
        }
      ],
      "responsibilities": [
        "Load the selected project and contain resolution inputs inside its snapshot."
      ],
      "forbidden_responsibilities": [
        "Process I/O, fact serialization and architecture policy."
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMP-PROTOCOL",
      "label": "protocol",
      "role": "component",
      "packages": [],
      "exact_modules": [
        "archkeel.typescript.src.protocol_x2e_ts"
      ],
      "public": [
        "archkeel.typescript.src.protocol_x2e_ts"
      ],
      "requires": [],
      "responsibilities": [
        "Validate wire requests and define source records, targets and evidence identities."
      ],
      "forbidden_responsibilities": [
        "Project loading, AST extraction and architecture policy."
      ],
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    }
  ],
  "rules": [
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "include_type_checking": true,
      "rationale": "Keep process hosting above extraction, project resolution and wire values.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "archkeel.typescript",
      "rationale": "Every selected source module needs an explicit owner.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Component dependencies must remain readable in one direction.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "MODULE-NO-CYCLES",
      "kind": "no_component_cycles",
      "level": "module",
      "rationale": "Prevent module cycles if a component later gains more files.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Sibling components may cross only through their declared whole modules.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "EXTERNAL-COMPLETE",
      "kind": "complete_external_scope",
      "source": "archkeel.typescript",
      "rationale": "New third-party imports require a named dependency decision.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "EXTERNAL-TYPESCRIPT",
      "kind": "external_dependency_scope",
      "dependency": "typescript",
      "exact_sources": [
        "archkeel.typescript.src.collect_x2e_ts",
        "archkeel.typescript.src.project_x2e_ts"
      ],
      "rationale": "Only project resolution and AST extraction depend on the pinned TypeScript compiler.",
      "provenance": [
        "docs/architecture/architecture.md"
      ],
      "decided_by": "agent"
    }
  ]
}
