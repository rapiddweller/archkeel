{
  "$schema": "../../../schema/architecture-contract.schema.json",
  "schema_version": "2.2.0",
  "components": [
    {
      "id": "CLI-ARGUMENTS",
      "label": "arguments",
      "role": "component",
      "public": [
        "archkeel.cli.arguments:CLIArguments",
        "archkeel.cli.arguments:Command",
        "archkeel.cli.arguments:ReportMode",
        "archkeel.cli.arguments:SkillAction",
        "archkeel.cli.arguments:ConfigurationSource",
        "archkeel.cli.arguments:configuration_source",
        "archkeel.cli.arguments:report_mode",
        "archkeel.cli.arguments:source_language",
        "archkeel.cli.arguments:installation_agent",
        "archkeel.cli.arguments:skill_action"
      ],
      "responsibilities": [
        "Decode closed CLI arguments into the declared Namespace fields and preserve argument wire behavior."
      ],
      "forbidden_responsibilities": [
        "Executing workflows, scanning source or writing installed instructions."
      ],
      "provenance": [
        "docs/architecture/cli-input-types.md"
      ],
      "decided_by": "architect",
      "requires": [
        {
          "component": "installer",
          "through": [
            "archkeel.cli.skill:InstallationAgent"
          ],
          "rationale": "The argument decoder consumes the installer-owned agent vocabulary."
        }
      ],
      "exact_modules": [
        "archkeel.cli.arguments"
      ],
      "packages": []
    },
    {
      "id": "CLI-INSTALLER",
      "label": "installer",
      "role": "component",
      "public": [
        "archkeel.cli.skill:InstallationAgent",
        "archkeel.cli.skill:install_skill"
      ],
      "responsibilities": [
        "Install the canonical agent instructions and parse only the owned legacy managed-section protocol."
      ],
      "forbidden_responsibilities": [
        "Deciding Core rule verdicts, owning command grammar or reconstructing source evidence."
      ],
      "provenance": [
        "docs/architecture/cli-input-types.md"
      ],
      "decided_by": "architect",
      "exact_modules": [
        "archkeel.cli.skill"
      ],
      "packages": []
    },
    {
      "id": "CLI-COMPOSITION",
      "label": "composition",
      "role": "component",
      "public": [
        "archkeel.cli:main"
      ],
      "responsibilities": [
        "Compose typed argument input, configuration, observation, Core workflows and rendered output."
      ],
      "forbidden_responsibilities": [
        "Redefining shared language identity or reconstructing closed protocol states from literal strings."
      ],
      "provenance": [
        "docs/architecture/cli-input-types.md"
      ],
      "decided_by": "architect",
      "requires": [
        {
          "component": "arguments",
          "rationale": "Consume the declared typed Namespace and argument decoders."
        },
        {
          "component": "installer",
          "through": [
            "archkeel.cli.skill:InstallationAgent",
            "archkeel.cli.skill:install_skill"
          ],
          "rationale": "Dispatch the selected installer through its declared API."
        }
      ],
      "exact_modules": [
        "archkeel.cli",
        "archkeel.cli.__main__",
        "archkeel.cli.config",
        "archkeel.cli.observe"
      ],
      "packages": []
    }
  ],
