  "rules": [
    {
      "id": "TARGET-COMPLETE_REQUIRES",
      "kind": "complete_requires",
      "rationale": "Only intended component dependencies are permitted.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TARGET-COMPLETE_ASSIGNMENT",
      "kind": "complete_assignment",
      "rationale": "Every source module has one owner.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent",
      "source": "archkeel.analyzer.python"
    },
    {
      "id": "TARGET-NO_COMPONENT_CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Components have one dependency direction.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TARGET-INTERFACE_BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Crossings use declared public interfaces.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TARGET-COLLECTORS-ISOLATED",
      "kind": "sibling_isolation",
      "members": [
        "archkeel.analyzer.python.bindings",
        "archkeel.analyzer.python.calls",
        "archkeel.analyzer.python.constructs",
        "archkeel.analyzer.python.imports",
        "archkeel.analyzer.python.private_attributes",
        "archkeel.analyzer.python.references",
        "archkeel.analyzer.python.state",
        "archkeel.analyzer.python.symbols",
        "archkeel.analyzer.python.type_shapes",
        "archkeel.analyzer.python.typing_signals"
      ],
      "rationale": "Collectors read the shared parsed and resolved project. Peer imports would make collection order implicit.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "SOURCE-RESOLUTION-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.python.resolve._scoped_binding",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "Dispatch on the shared nominal source-resolution domain at the actual scoped-binding producer.",
      "decided_by": "architect",
      "provenance": [
        "docs/architecture/source-resolution-types.md"
      ]
    },
    {
      "id": "SOURCE-SYMBOL-BASE-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.python.symbols._record_class_bases",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "Select known source symbol tags through the one Facts-owned domain; future record payload and JSON identities remain data.",
      "provenance": [
        "docs/architecture/source-symbol-consumers.md"
      ],
      "decided_by": "architect"
    }
  ],
