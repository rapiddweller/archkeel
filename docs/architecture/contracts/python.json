        "archkeel.analyzer.python.references",
        "archkeel.analyzer.python.state",
        "archkeel.analyzer.python.symbols",
        "archkeel.analyzer.python.type_shapes",
        "archkeel.analyzer.python.typing_signals"
      ],
      "rationale": "Collectors read the shared parsed and resolved project. Peer imports would make collection order implicit.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    }
  ],
