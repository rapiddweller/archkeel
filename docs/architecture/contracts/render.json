      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "This owned result decision uses canonical controls; rendered wording and arbitrary identities remain data.",
      "provenance": [
        "docs/architecture/core-command-result-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-REPORT-UNKNOWN-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.summary.report_leaves_rules_undecided",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "This owned result decision uses canonical controls; rendered wording and arbitrary identities remain data.",
      "provenance": [
        "docs/architecture/core-command-result-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-RESULT-BADGE-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.summary._decision_badge",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "This owned result decision uses canonical controls; rendered wording and arbitrary identities remain data.",
      "provenance": [
        "docs/architecture/core-command-result-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-STRUCTURE-LEVEL-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.html._structure_overview_body",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "Structure decisions consume the owner's nominal measurement level; names and JSON keys remain data.",
      "provenance": [
        "docs/architecture/structure-level-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "CALL-CHANGE-SUMMARY",
      "kind": "forbidden_construct",
      "source": "archkeel.render.summary._call_site_lines",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "Select owned control members at the actual consumer; paths, rendered text and JSON keys remain data.",
      "provenance": [
        "docs/architecture/unresolved-call-change-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TERMINAL-RULE-ASSESSMENT-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.terminal.print_result",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "Select owned control members at the actual consumer; paths, rendered text and JSON keys remain data.",
      "provenance": [
        "docs/architecture/unresolved-call-change-types.md"
      ],
      "decided_by": "architect"
    }
  ],
