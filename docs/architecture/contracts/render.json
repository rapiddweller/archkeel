{
  "$schema": "../../../schema/architecture-contract.schema.json",
  "schema_version": "2.2.0",
  "components": [
    {
      "id": "RENDER-HTML",
      "label": "html",
      "role": "projection",
      "exact_modules": [
        "archkeel.render",
        "archkeel.render.html"
      ],
      "public": [
        "archkeel.render.html"
      ],
      "responsibilities": [
        "Compose offline HTML from authenticated results, Atlas payload and shared summaries."
      ],
      "forbidden_responsibilities": [
        "Architecture policy, source parsing and persistence.",
        "Rule evaluation and scene/layout policy duplicated in Python composition."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md",
        "docs/architecture/target/design.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "summary",
          "rationale": "Use the shared explanation of Core verdicts.",
          "decided_by": "agent",
          "through": [
            "archkeel.render.summary:Comparison",
            "archkeel.render.summary:VerdictRow",
            "archkeel.render.summary:check_summary",
            "archkeel.render.summary:report_summary",
            "archkeel.render.summary:report_violates_rules",
            "archkeel.render.summary_badges:BadgeState",
            "archkeel.render.summary_badges:badge"
          ]
        },
        {
          "component": "atlas-payload",
          "rationale": "Compose HTML from the Atlas payload prepared from authenticated Core values.",
          "decided_by": "agent",
          "through": [
            "archkeel.render.atlas:atlas_payload",
            "archkeel.render.atlas:boundary_permissions_payload"
          ]
        }
      ],
      "packages": []
    },
    {
      "id": "RENDER-ATLAS-PAYLOAD",
      "label": "atlas-payload",
      "role": "projection",
      "exact_modules": [
        "archkeel.render.atlas",
        "archkeel.render.atlas_deviations"
      ],
      "public": [
        "archkeel.render.atlas:atlas_payload",
        "archkeel.render.atlas:boundary_permissions_payload"
      ],
      "responsibilities": [
        "Project authenticated report evidence into browser scene inputs."
      ],
      "forbidden_responsibilities": [
        "Compose HTML, format terminal output or change Core verdicts.",
        "Depending on HTML composition and changing evidence or permissions."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md",
        "docs/architecture/render-target.md",
        "docs/architecture/decisions/ad-213-renderer-responsibility-boundaries.md",
        "docs/architecture/decisions/ad-219-atlas-boundary-permissions.md",
        "docs/superpowers/specs/2026-10-16-atlas-deviation-boundary.md",
        "docs/architecture/target/design.md"
      ],
      "decided_by": "agent",
      "requires": [],
      "packages": []
    },
    {
      "id": "RENDER-SUMMARY",
      "label": "summary",
      "role": "projection",
      "exact_modules": [
        "archkeel.render.summary",
        "archkeel.render.summary_badges"
      ],
      "public": [
        "archkeel.render.summary",
        "archkeel.render.summary_badges:BadgeState",
        "archkeel.render.summary_badges:Badge",
        "archkeel.render.summary_badges:badge"
      ],
      "responsibilities": [
        "Explain recorded verdicts and measurements through reusable typed summaries and badges."
      ],
      "forbidden_responsibilities": [
        "Architecture policy, source parsing and persistence.",
        "Rendering HTML and independently deciding architecture verdicts."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md",
        "docs/architecture/summary-badges.md",
        "docs/architecture/target/design.md"
      ],
      "decided_by": "agent",
      "requires": [],
      "packages": []
    },
    {
      "id": "RENDER-TERMINAL",
      "label": "terminal",
      "role": "projection",
      "exact_modules": [
        "archkeel.render.terminal"
      ],
      "public": [
        "archkeel.render.terminal"
      ],
      "responsibilities": [
        "Format shared typed summaries for terminal users."
      ],
      "forbidden_responsibilities": [
        "Architecture policy, source parsing and persistence.",
        "Duplicating summary derivation or evaluating rules."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md",
        "docs/architecture/target/design.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "summary",
          "rationale": "Terminal formatting consumes the shared result explanation.",
          "decided_by": "agent",
          "through": [
            "archkeel.render.summary:Summary",
            "archkeel.render.summary_badges:Badge",
            "archkeel.render.summary_badges:BadgeState",
            "archkeel.render.summary_badges:badge"
          ]
        }
      ],
      "packages": []
    }
  ],
  "rules": [
    {
      "id": "RENDER-COMPLETE-REQUIRES",
      "kind": "complete_requires",
      "rationale": "HTML consumes the Atlas payload and shared summary; terminal consumes the summary, and neither helper depends on HTML.",
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "RENDER-COMPLETE-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "archkeel.render",
      "rationale": "Every maintained render source module has one presentation responsibility.",
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "RENDER-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "The presentation data flow stays acyclic.",
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "RENDER-INTERFACE",
      "kind": "interface_boundary",
      "rationale": "Presentation crossings use the explicitly published boundary.",
      "provenance": [
        "docs/architecture/decisions/ad-179-reports-render-one-graph-boundary.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "RENDER-BADGE-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.summary_badges",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The actual Badge model and derivation use owned display states and canonical Core verdict types, including conversion at the input boundary.",
      "provenance": [
        "docs/architecture/summary-badges.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-DEVIATION-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.atlas_deviations",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The real deviation value and pair derivation use their owned kind at all closed decisions.",
      "provenance": [
        "docs/superpowers/specs/2026-10-16-atlas-deviation-boundary.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-RULE-LEGEND-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.render.html._atlas_rule_status_cards",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "This owned result decision uses canonical controls; rendered wording and arbitrary identities remain data.",
      "provenance": [
        "docs/architecture/core-command-result-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "RENDER-REPORT-FAILURE-CONTROL",
