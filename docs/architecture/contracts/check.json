      "source": "archkeel.check.evaluation.topology.aggregate_edges",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The owned aggregation decision uses the canonical topology domain, distinct from cycle policy and structure-report levels.",
      "provenance": [
        "docs/architecture/graph-topology-level-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "CALL-CHANGE-VALIDATION-FILTER",
