          "rationale": "Read immutable repository and runtime inputs.",
          "decided_by": "agent"
        },
        {
          "component": "observation",
          "rationale": "Request a Core-owned observation of collected facts.",
          "decided_by": "agent"
        },
        {
          "component": "regression",
          "rationale": "Compare observations and enforce selected ceilings.",
          "decided_by": "agent"
        },
        {
          "component": "evaluation",
          "rationale": "Evaluate the authenticated UML graph with Core policy.",
          "decided_by": "agent"
        }
      ],
