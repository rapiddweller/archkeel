{
  "$schema": "../../../schema/architecture-contract.schema.json",
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "TARGET-ENTRY",
      "label": "entry",
      "role": "component",
      "packages": ["archkeel.analyzer.dart"],
      "responsibilities": [
        "Launch the prepared native Dart Analyzer collector through the shared protocol."
      ],
      "forbidden_responsibilities": [
        "Architecture policy."
      ],
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent",
      "exact_modules": ["archkeel.analyzer.dart"],
      "public": []
    }
  ],
  "rules": [
    {
      "id": "TARGET-COMPLETE_REQUIRES",
      "kind": "complete_requires",
      "rationale": "Only intended component dependencies are permitted.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TARGET-COMPLETE_ASSIGNMENT",
      "kind": "complete_assignment",
      "rationale": "Every source module has one owner.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent",
      "source": "archkeel.analyzer.dart"
    },
    {
      "id": "TARGET-NO_COMPONENT_CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Components have one dependency direction.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "TARGET-INTERFACE_BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Crossings use declared public interfaces.",
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent"
    }
  ],
  "declarations": {
    "modules": [
      {
        "path": "src/archkeel/analyzer/dart/entry.py",
        "responsibility": "Serve the shared process protocol."
      },
      {
        "path": "src/archkeel/analyzer/dart/native/lib/collector.dart",
        "responsibility": "Collect Analyzer-backed Dart declarations and source coverage."
      },
      {
        "path": "src/archkeel/analyzer/dart/native/lib/snapshot.dart",
        "responsibility": "Validate and stage source inputs for bounded Analyzer resolution."
      },
      {
        "path": "src/archkeel/analyzer/dart/setup.py",
        "responsibility": "Prepare pinned native collector dependencies on explicit request."
      }
    ]
  }
}
