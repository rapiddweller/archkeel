        "archkeel.analyzer.typescript.config:join",
        "archkeel.analyzer.typescript.config:load_config",
        "archkeel.analyzer.typescript.config:within",
        "archkeel.analyzer.typescript.config:Json",
        "archkeel.analyzer.typescript.config:has_field"
      ],
      "provenance": [
        "docs/architecture/typescript-control-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TARGET-RESOLUTION",
      "label": "resolution",
      "role": "component",
      "packages": [
        "archkeel.analyzer.typescript.resolve"
      ],
      "responsibilities": [
        "Own bounded import resolution, package protocol decoding, source-kind passes and loading format."
      ],
      "forbidden_responsibilities": [
        "Read TSConfig independently, parse TypeScript or evaluate architecture policy."
      ],
      "public": [
        "archkeel.analyzer.typescript.resolve:Found",
        "archkeel.analyzer.typescript.resolve:ModuleFormat",
        "archkeel.analyzer.typescript.resolve:Resolver",
        "archkeel.analyzer.typescript.resolve:Unknown",
        "archkeel.analyzer.typescript.resolve:is_builtin",
        "archkeel.analyzer.typescript.resolve:is_relative",
        "archkeel.analyzer.typescript.resolve:package_name"
      ],
      "requires": [
        {
          "component": "configuration",
          "rationale": "Use the snapshot and the single typed compiler/path grammar boundary.",
          "decided_by": "architect"
        }
      ],
      "provenance": [
        "docs/architecture/typescript-control-types.md"
      ],
      "decided_by": "architect"
    }
