{
  "$schema": "../../../schema/architecture-contract.schema.json",
  "schema_version": "2.2.0",
  "components": [
    {
      "id": "TARGET-ENTRY",
      "label": "entry",
      "role": "component",
      "packages": [
        "archkeel.analyzer.typescript.entry",
        "archkeel.analyzer.typescript.collect"
      ],
      "responsibilities": [
        "Serve the protocol and walk the selected files and the local files their imports reach."
      ],
      "forbidden_responsibilities": [
        "Architecture policy, tree-sitter nodes and filesystem reads outside the snapshot."
      ],
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent",
      "exact_modules": [
        "archkeel.analyzer.typescript"
      ],
      "requires": [
        {
          "component": "source",
          "rationale": "Read lexical syntax facts without importing tree-sitter.",
          "decided_by": "agent"
        },
        {
          "component": "configuration",
          "rationale": "Select contained source inputs and consume typed compiler modes.",
          "decided_by": "agent"
        },
        {
          "component": "resolution",
          "rationale": "Resolve imports through typed format and bounded source lookup.",
          "decided_by": "agent"
        }
      ],
      "public": []
    },
    {
      "id": "TARGET-SOURCE",
      "label": "source",
      "role": "component",
      "packages": [
        "archkeel.analyzer.typescript.parse"
      ],
      "responsibilities": [
        "Own tree-sitter parsing and lexical TypeScript syntax facts; do not select files or resolve imports."
      ],
      "forbidden_responsibilities": [
        "Claiming type-checker semantics, resolving what the compiler would not prove, or evaluating architecture policy."
      ],
      "provenance": [
        "docs/architecture/language-adapter-target.md"
      ],
      "decided_by": "agent",
      "public": [
        "archkeel.analyzer.typescript.parse"
      ]
    },
    {
      "id": "TARGET-CONFIGURATION",
      "label": "configuration",
      "role": "component",
      "packages": [
        "archkeel.analyzer.typescript.config"
      ],
      "responsibilities": [
        "Own TSConfig reading, snapshot containment, file selection and conversion into typed compiler options and path grammar."
      ],
      "forbidden_responsibilities": [
        "Resolve imports, interpret source declarations or evaluate architecture policy."
      ],
      "public": [
        "archkeel.analyzer.typescript.config:Config",
        "archkeel.analyzer.typescript.config:ModuleKind",
        "archkeel.analyzer.typescript.config:ModuleResolution",
        "archkeel.analyzer.typescript.config:Options",
        "archkeel.analyzer.typescript.config:PathToken",
        "archkeel.analyzer.typescript.config:ScriptTarget",
