        "archkeel.analyzer.typescript.entry",
        "archkeel.analyzer.typescript.collect"
      ],
      "responsibilities": [
        "Serve the protocol and walk the selected files and the local files their imports reach."
      ],
      "forbidden_responsibilities": [
        "Architecture policy, tree-sitter nodes and filesystem reads outside the snapshot."
