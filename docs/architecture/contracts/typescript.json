        "docs/architecture/typescript-control-types.md",
        "docs/architecture/typescript-source-input.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TARGET-TYPESCRIPT-PARSER-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.typescript.parse",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The native comparison guard covers this complete migrated module without parser/protocol exceptions; closed syntax and semantic dispatch use owned nominal domains.",
      "provenance": [
        "docs/architecture/typescript-syntax-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TARGET-TYPESCRIPT-COLLECTOR-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.typescript.collect",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The native comparison guard covers this complete migrated module without parser/protocol exceptions; closed syntax and semantic dispatch use owned nominal domains.",
      "provenance": [
        "docs/architecture/typescript-syntax-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TARGET-TYPESCRIPT-SYNTAX-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.typescript.syntax",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The syntax DTO owner normalizes its closed legacy inputs once; native comparison guards cover this whole module without parser/protocol exceptions.",
      "provenance": [
        "docs/architecture/typescript-syntax-types.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "TARGET-TYPESCRIPT-INPUT-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.analyzer.typescript.source_input",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "The input decoder owns the grammar; native whole-module comparison and written prefix/suffix observation has no parser, form or source exceptions.",
      "provenance": [
        "docs/architecture/typescript-source-input.md"
      ],
      "decided_by": "architect"
    }
