          "component": "source",
          "rationale": "Read lexical syntax facts without importing tree-sitter.",
          "decided_by": "agent"
        },
        {
          "component": "configuration",
          "rationale": "Select contained source inputs and consume typed compiler modes.",
          "decided_by": "agent"
        },
        {
          "component": "resolution",
          "rationale": "Resolve imports through typed format and bounded source lookup.",
          "decided_by": "agent"
        },
        {
          "component": "input",
          "rationale": "Consume the shared nominal filename and specifier input grammar; retain local policy and I/O ownership.",
          "decided_by": "architect"
        }
      ],
      "public": []
    },
