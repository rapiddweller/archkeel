{
  "$schema": "../../../schema/architecture-contract.schema.json",
  "schema_version": "2.2.0",
  "components": [
    {
      "id": "STUDIO-API",
      "label": "api",
      "role": "component",
      "public": [
        "archkeel.studio.api:AgentKind",
        "archkeel.studio.api:ApiPath",
        "archkeel.studio.api:CallStatus",
        "archkeel.studio.api:ChatAnswer",
        "archkeel.studio.api:ChatBlock",
        "archkeel.studio.api:ChatBlockKind",
        "archkeel.studio.api:ChatError",
        "archkeel.studio.api:ChatFailure",
        "archkeel.studio.api:ChatRequest",
        "archkeel.studio.api:ContractState",
        "archkeel.studio.api:ExploreState",
        "archkeel.studio.api:Fact",
        "archkeel.studio.api:MediaType",
        "archkeel.studio.api:Route",
        "archkeel.studio.api:StudioState",
        "archkeel.studio.api:UiAsset",
        "archkeel.studio.api:chat_json",
        "archkeel.studio.api:failure_json",
        "archkeel.studio.api:parse_chat_request",
        "archkeel.studio.api:state_json"
      ],
      "responsibilities": [
        "Declare the versioned HTTP API: its routes, the served UI files, the typed state and the typed chat bodies with their JSON forms."
      ],
      "forbidden_responsibilities": [
        "Network, process or file access.",
        "A route that writes: only a planned proposals component may take a write, after an explicit architect action."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md",
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent",
      "requires": [],
      "exact_modules": [
        "archkeel.studio.api"
      ],
      "packages": []
    },
    {
      "id": "STUDIO-WORKSPACE",
      "label": "workspace",
      "role": "component",
      "public": [
        "archkeel.studio.workspace:Workspace"
      ],
      "responsibilities": [
        "Make the explore snapshot of the root in a private folder of this run below the cache, read its files by exact name, index the snapshot once and delete the folder at the end."
      ],
      "forbidden_responsibilities": [
        "HTTP, tokens or browser pages.",
        "Writing into the repository or a contract."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md",
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "api",
          "through": [
            "archkeel.studio.api:ContractState",
            "archkeel.studio.api:ExploreState",
            "archkeel.studio.api:StudioState"
          ],
          "rationale": "Report the run and the contract as the typed state of the API."
        },
        {
          "component": "answer",
          "through": [
            "archkeel.studio.answer:Snapshot"
          ],
          "rationale": "Index the snapshot that explore made, with the reader that the CLI injects."
        }
      ],
      "exact_modules": [
        "archkeel.studio.workspace"
      ],
      "packages": []
    },
    {
      "id": "STUDIO-AGENT",
      "label": "agent",
      "role": "component",
      "public": [
        "archkeel.studio.agent:Agent",
        "archkeel.studio.agent:Reply"
      ],
      "responsibilities": [
        "Run the coding agent of the owner (claude by default, codex on request) as one child process at a time, with a timeout, an output limit, a scrubbed environment and a kill of its process group, and discard the run if the repository changed."
      ],
      "forbidden_responsibilities": [
        "HTTP, tokens or browser pages.",
        "Reading the snapshot, judging an answer or writing a fact.",
        "Passing an API key or reading an auth file."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "api",
          "through": [
            "archkeel.studio.api:AgentKind",
            "archkeel.studio.api:ChatError",
            "archkeel.studio.api:ChatFailure",
            "archkeel.studio.api:ChatRequest"
          ],
          "rationale": "Name the agent, the request and each break with the typed vocabulary of the API."
        }
      ],
      "exact_modules": [
        "archkeel.studio.agent"
      ],
      "packages": []
    },
    {
      "id": "STUDIO-ANSWER",
      "label": "answer",
      "role": "component",
      "public": [
        "archkeel.studio.answer:Snapshot"
      ],
      "responsibilities": [
        "Index the symbols and calls of the snapshot, compute every OBSERVED fact from it and check the text of an agent strictly against it."
      ],
      "forbidden_responsibilities": [
        "Network, process or file access.",
        "Taking a fact from agent text."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "api",
          "through": [
            "archkeel.studio.api:AgentKind",
            "archkeel.studio.api:CallStatus",
            "archkeel.studio.api:ChatAnswer",
            "archkeel.studio.api:ChatBlock",
            "archkeel.studio.api:ChatBlockKind",
            "archkeel.studio.api:ChatError",
            "archkeel.studio.api:ChatFailure",
            "archkeel.studio.api:Fact"
          ],
          "rationale": "Build the typed answer and name each break with the typed vocabulary of the API."
        }
      ],
      "exact_modules": [
        "archkeel.studio.answer"
      ],
      "packages": []
    },
    {
      "id": "STUDIO-SERVER",
      "label": "server",
      "role": "component",
      "public": [
        "archkeel.studio.server:is_studio",
        "archkeel.studio.server:run_studio"
      ],
      "responsibilities": [
        "Serve the shell, the API and the snapshot files on 127.0.0.1 behind a per-run token, check and route each chat request, end after an idle time and tell whether a URL is a Studio."
      ],
      "forbidden_responsibilities": [
        "Starting processes, analyzing source or writing files."
      ],
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md",
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "api",
          "through": [
            "archkeel.studio.api:AgentKind",
            "archkeel.studio.api:ApiPath",
            "archkeel.studio.api:ChatAnswer",
            "archkeel.studio.api:ChatError",
            "archkeel.studio.api:ChatFailure",
            "archkeel.studio.api:MediaType",
            "archkeel.studio.api:Route",
            "archkeel.studio.api:UiAsset",
            "archkeel.studio.api:chat_json",
            "archkeel.studio.api:failure_json",
            "archkeel.studio.api:parse_chat_request",
            "archkeel.studio.api:state_json"
          ],
          "rationale": "Route requests by the typed API vocabulary, read the chat body and send the JSON forms."
        },
        {
          "component": "workspace",
          "through": [
            "archkeel.studio.workspace:Workspace"
          ],
          "rationale": "Read the state and the snapshot files of the one workspace it serves."
        },
        {
          "component": "agent",
          "through": [
            "archkeel.studio.agent:Agent"
          ],
          "rationale": "Let the one agent answer a question; the server starts no process."
        }
      ],
      "exact_modules": [
        "archkeel.studio",
        "archkeel.studio.server"
      ],
      "packages": []
    }
  ],
  "rules": [
    {
      "id": "STUDIO-REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "rationale": "Studio owners cross only the edges they ask for: views of the API never reach the process or the network.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-ASSIGNMENT",
      "kind": "complete_assignment",
      "source": "archkeel.studio",
      "rationale": "Every Studio module belongs to the API, the agent, the answer, the workspace or the server.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md",
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "The API stays a leaf below the answer, the agent, the workspace and the server.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Studio owners talk only through their declared public names.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-TYPED-CONTROL",
      "kind": "forbidden_construct",
      "source": "archkeel.studio",
      "constructs": [
        "string_literal_compare"
      ],
      "rationale": "URL segments and states are decoded into the API enums before a decision.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-PROCESS-IN-WORKSPACE",
      "kind": "external_dependency_scope",
      "dependency": "subprocess",
      "exact_sources": [
        "archkeel.studio.agent",
        "archkeel.studio.workspace"
      ],
      "rationale": "Only the workspace and the agent start a child process: the explore child writes only into the cache folder; the read-only agent writes nothing, and the repository stays unchanged.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md",
        "docs/architecture/decisions/ad-292-the-studio-chat-lets-the-owners-agent-answer-read-only.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "STUDIO-HTTP-IN-SERVER",
      "kind": "external_dependency_scope",
      "dependency": "http",
      "exact_sources": [
        "archkeel.studio.server"
      ],
      "rationale": "Only the server speaks HTTP; the API, the agent, the answer and the workspace stay testable without a socket.",
      "provenance": [
        "docs/architecture/decisions/ad-290-archkeel-studio-is-a-local-web-application.md"
      ],
      "decided_by": "agent"
    }
  ]
}
