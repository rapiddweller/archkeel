        },
        {
          "component": "exit",
          "rationale": "Print the startup result."
        },
        {
          "component": "frame",
          "rationale": "Read the verified frame of the native core."
        },
        {
          "component": "json",
          "rationale": "Read the topology and the system declared by the frame."
        },
        {
          "component": "launch",
