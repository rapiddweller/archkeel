      ]
    },
    {
      "id": "SHELL-EXPLORER-HOST",
      "label": "explorer-host",
      "role": "component",
      "layer": "present",
      "packages": [],
      "exact_modules": [
        "archkeel.cli.core_explorer",
        "archkeel.cli.core_explorer_http",
        "archkeel.cli.core_explorer_identity",
        "archkeel.explorer_agent"
      ],
      "responsibilities": [
