  "rules": [
    {
      "id": "DEP-MODEL-NO-STORE",
      "kind": "forbidden_dependency",
      "source": "shop.model",
      "target": "shop.store",
      "include_type_checking": true,
      "rationale": "Order and Line value types stay independent of any persistence mechanism.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-MODEL-NO-APP",
      "kind": "forbidden_dependency",
      "source": "shop.model",
      "target": "shop.app",
      "include_type_checking": true,
      "rationale": "Value types remain reusable without depending on the use cases that construct them.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-MODEL-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "shop.model",
      "target": "shop.render",
      "include_type_checking": true,
      "rationale": "Value types remain independent of how orders are projected as text.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-MODEL-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "shop.model",
      "target": "shop.cli",
      "include_type_checking": true,
      "rationale": "Value types remain independent of command-line composition.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-STORE-NO-APP",
      "kind": "forbidden_dependency",
      "source": "shop.store",
      "target": "shop.app",
      "include_type_checking": true,
      "rationale": "Persistence stays a leaf dependency and never calls back into use cases.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-STORE-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "shop.store",
      "target": "shop.render",
      "include_type_checking": true,
      "rationale": "Persistence remains independent of how orders are displayed.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-STORE-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "shop.store",
      "target": "shop.cli",
      "include_type_checking": true,
      "rationale": "Persistence stays callable without command-line orchestration.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "shop.app",
      "target": "shop.render",
      "include_type_checking": true,
      "rationale": "Use cases return typed values; only the composition root decides how to project them.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "shop.app",
      "target": "shop.cli",
      "include_type_checking": true,
      "rationale": "Use cases remain callable without command-line orchestration.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-STORE",
      "kind": "forbidden_dependency",
      "source": "shop.render",
      "target": "shop.store",
      "include_type_checking": true,
      "rationale": "Text projection consumes typed values without touching persistence.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-APP",
      "kind": "forbidden_dependency",
      "source": "shop.render",
      "target": "shop.app",
      "include_type_checking": true,
      "rationale": "Text projection stays a pure view over values, not a caller of use cases.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "shop.render",
      "target": "shop.cli",
      "include_type_checking": true,
      "rationale": "Text projection remains reusable without command-line composition.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-NO-MODEL",
      "kind": "forbidden_dependency",
      "source": "shop.cli",
      "target": "shop.model",
      "include_type_checking": true,
      "rationale": "The composition root reaches domain values only through the use cases it calls.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-NO-STORE",
      "kind": "forbidden_dependency",
      "source": "shop.cli",
      "target": "shop.store",
      "include_type_checking": true,
      "rationale": "The composition root reaches persistence only through the use cases it calls.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-NO-STORE-SQLITE",
      "kind": "forbidden_dependency",
      "source": "shop.app",
      "target": "shop.store.sqlite",
      "include_type_checking": false,
      "allowed_sources": ["shop.app.maintenance"],
      "rationale": "Only the maintenance use case may run store housekeeping; ordinary order use cases stay on the repository.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-NO-STORE-BACKEND",
      "kind": "forbidden_dependency",
      "source": "shop.app",
      "target": "shop.store.backend",
      "include_type_checking": true,
      "rationale": "The file layout behind the repository is the store's own business; use cases reach persistence through OrderRepository, never through its backend.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-STORE-NO-MONEY",
      "kind": "forbidden_dependency",
      "source": "shop.store",
      "target": "shop.model.entities",
      "target_symbol": "Money",
      "include_type_checking": true,
      "rationale": "Persistence serialises whole orders and must not compute or interpret money amounts itself.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-STORE-ALLOWS-MODEL",
      "kind": "allowed_dependency",
      "source": "shop.store",
      "target": "shop.model",
      "rationale": "Persistence serialises the domain values it is given.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-ALLOWS-MODEL",
      "kind": "allowed_dependency",
      "source": "shop.app",
      "target": "shop.model",
      "rationale": "Use cases construct orders from domain values.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-APP-ALLOWS-STORE",
      "kind": "allowed_dependency",
      "source": "shop.app",
      "target": "shop.store",
      "rationale": "Use cases persist and load orders through the repository.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-ALLOWS-MODEL",
      "kind": "allowed_dependency",
      "source": "shop.render",
      "target": "shop.model",
      "rationale": "Text projection reads the values it renders.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-APP",
      "kind": "allowed_dependency",
      "source": "shop.cli",
      "target": "shop.app",
      "rationale": "The composition root invokes the order use cases.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-RENDER",
      "kind": "allowed_dependency",
      "source": "shop.cli",
      "target": "shop.render",
      "rationale": "The composition root prints the rendered order.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-DYNAMIC",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["getattr", "hasattr", "cast", "eval", "exec", "dynamic_import", "type_ignore", "setattr", "delattr", "vars", "dunder_dict"],
      "rationale": "Static architecture evidence remains explicit and mechanically traceable.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-ANY",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["any_annotation"],
      "rationale": "A value that crosses a module boundary carries a type the reader can follow; Any hides exactly what the boundary exists to state.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-PLACEHOLDER",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["placeholder_body"],
      "rationale": "A function whose body is pass, ellipsis or a lone NotImplementedError reports capability it does not have, and its callers are written against that promise.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-STRING-LITERAL-COMPARE",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["string_literal_compare"],
      "rationale": "A closed vocabulary is an enum or Literal the type checker follows; a value compared with a string literal is a vocabulary nobody declared.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-ASSERT",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["assert"],
      "rationale": "Invariants are checked where values are built, because assert statements vanish under python -O.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-BROAD-EXCEPT",
      "kind": "forbidden_construct",
      "source": "shop",
      "constructs": ["broad_except"],
      "exact_sources": ["shop.cli.main.main"],
      "rationale": "Failures stay typed and visible; only the CLI error boundary, main's own body, turns any failure into an exit code.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-COMPLETE",
      "kind": "complete_external_scope",
      "source": "shop",
      "rationale": "A dependency no rule names is a dependency nobody chose, and a package that does not exist looks exactly the same from inside the code.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-JSON-STORE",
      "kind": "external_dependency_scope",
      "dependency": "json",
      "allowed_sources": ["shop.store"],
      "rationale": "Only the store component chooses the JSON file format; other components stay format-agnostic.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "shop",
      "rationale": "A module without one owning component escapes every boundary rule.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Components stay layered so each one can be reviewed and replaced in dependency order.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Components communicate only through declared interfaces, so reaching into another component's internals requires a visible contract change.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "STORE-PEERS-ISOLATED",
      "kind": "sibling_isolation",
      "members": ["shop.store.repository", "shop.store.sqlite"],
      "rationale": "Persistence and maintenance are peers behind the store's entry point, so neither reaches into the other.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "MODEL-TYPES-IN-ENTITIES",
      "kind": "symbol_placement",
      "source": "shop.model",
      "class_kinds": ["dataclass"],
      "exact_sources": ["shop.model.entities"],
      "rationale": "Every order, line and money type shop.model owns lives in one module, not scattered across the package.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    },
    {
      "id": "APP-TYPES-NOT-DICT",
      "kind": "boundary_types",
      "source": "shop.app",
      "rationale": "shop.app's functions take and return typed models, never a bare dict standing in for one.",
      "provenance": ["docs/architecture/shop.md"],
      "decided_by": "architect"
    }
  ]
}
