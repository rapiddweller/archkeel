{
  "schema_version": "2.2.0",
  "components": [
    {
      "id": "checkout-operation",
      "label": "Checkout operation",
      "role": "component",
      "packages": [],
      "public": [
        "orders.checkout.service:place",
        "orders.checkout.rounding:round_cents"
      ],
      "responsibilities": [
        "Price one order line, round it to cents and persist the receipt."
      ],
      "forbidden_responsibilities": [],
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent",
      "requires": [
        {
          "component": "Receipt model",
          "through": [
            "orders.checkout.receipts:Receipt"
          ],
          "rationale": "The operation returns a receipt.",
          "decided_by": "agent"
        }
      ],
      "exact_modules": [
        "orders.checkout",
        "orders.checkout.service",
        "orders.checkout.rounding"
      ]
    },
    {
      "id": "checkout-receipts",
      "label": "Receipt model",
      "role": "component",
      "packages": [],
      "public": [
        "orders.checkout.receipts:Receipt"
      ],
      "responsibilities": [
        "Define the immutable receipt returned to callers."
      ],
      "forbidden_responsibilities": [],
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent",
      "requires": [],
      "exact_modules": [
        "orders.checkout.receipts"
      ]
    }
  ],
  "rules": [
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "orders.checkout",
      "rationale": "Every module under orders.checkout has exactly one owner, so a review can name who answers for it.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "The receipt model never depends on the operation that builds it.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "The receipt is the only type the operation shares inside checkout.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent",
      "include_type_checking": true
    },
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "rationale": "The operation's use of the receipt model is declared.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    }
  ]
}
