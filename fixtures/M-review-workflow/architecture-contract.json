  "rules": [
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "orders",
      "rationale": "Every module under orders has exactly one owner, so a review can name who answers for it.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Order placement flows one way: entry, checkout, then pricing and storage.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Callers use a component's declared API, never its internals.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent",
      "include_type_checking": true
    },
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "rationale": "Every cross-component import is a declared, reasoned dependency.",
      "provenance": [
        "docs/target.md"
      ],
      "decided_by": "agent"
    }
  ],
