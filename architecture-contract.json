  "rules": [
    {
      "id": "DEP-IR-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "Stable evidence types remain usable without policy evaluation.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-IR-NO-ACCEPT",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.accept",
      "include_type_checking": true,
      "rationale": "Lock and observation types remain independent of acceptance orchestration.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-IR-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Evidence models and codecs remain reusable outside the command line.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-IR-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.host",
