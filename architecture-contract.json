        "archkeel.ir.architecture_graph:Coverage",
        "archkeel.ir.architecture_graph:DefinitionContext",
        "archkeel.ir.architecture_graph:Entity",
        "archkeel.ir.architecture_graph:EntityKind",
        "archkeel.ir.architecture_graph:GraphAssessment",
        "archkeel.ir.architecture_graph:EntityCorrespondence",
        "archkeel.ir.architecture_graph:GraphComparison",
        "archkeel.ir.architecture_graph:ModuleInventory",
        "archkeel.ir.architecture_graph:Parameter",
        "archkeel.ir.architecture_graph:PublicAPIEntry",
        "archkeel.ir.architecture_graph:Relationship",
        "archkeel.ir.architecture_graph:RelationshipKind",
        "archkeel.ir.architecture_graph:RootLayoutRule",
        "archkeel.ir.architecture_graph:Signature",
        "archkeel.ir.architecture_graph:TargetDefinition",
        "archkeel.ir.architecture_graph:TargetScope",
        "archkeel.ir.architecture_graph:Visibility",
