    {
      "id": "DEP-RENDER-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.render",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "Rendering consumes typed evidence rather than host implementations.",
