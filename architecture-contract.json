      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "The shared evidence model remains independent of Python source analysis.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-CHECK-NO-ACCEPT",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.accept",
      "include_type_checking": true,
      "rationale": "Policy evaluation must not create or mutate accepted state.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-CHECK-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Deterministic checks remain callable without command-line orchestration.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-CHECK-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "The deterministic core receives host evidence through an injected port.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-CHECK-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "The deterministic core receives observations through an injected port.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-ACCEPT-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.accept",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "Acceptance remains separate from deterministic policy evaluation.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-ACCEPT-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.accept",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Acceptance state remains usable without command-line orchestration.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-ACCEPT-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.accept",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "Acceptance stores opaque approval references instead of host-specific data.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-ACCEPT-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.accept",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "Acceptance must not trigger source analysis.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-CLI-NO-IR",
      "kind": "forbidden_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.ir",
      "include_type_checking": true,
      "rationale": "Command services mediate IR access so the CLI only composes workflows.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-HOST-NO-CHECK",
