        "archkeel.ir.interfaces",
        "archkeel.ir.identity:module_identity",
        "archkeel.ir.lock",
        "archkeel.ir.measurements",
        "archkeel.ir.model",
        "archkeel.ir.references",
        "archkeel.ir.renames:Renamed",
        "archkeel.ir.renames:module_layouts",
        "archkeel.ir.renames:observed_names",
        "archkeel.ir.renames:renames_since",
        "archkeel.ir.source_graph",
        "archkeel.ir.structure",
        "archkeel.ir.target_graph:component_permissions",
        "archkeel.ir.target_graph:declared_tree_graph",
        "archkeel.ir.target_records",
        "archkeel.ir.trace",
        "archkeel.ir.type_fanin",
        "archkeel.ir.widening",
        "archkeel.ir.facts",
        "archkeel.ir.facts_codec",
        "archkeel.ir.protocol",
        "archkeel.ir.state_facts",
        "archkeel.ir.type_shapes",
        "archkeel.ir.reexports",
        "archkeel.ir.graph",
        "archkeel.ir.profiles:Profile",
        "archkeel.ir.profiles:Language",
        "archkeel.ir.profiles:DeclarationField",
        "archkeel.ir.profiles:profile_for",
        "archkeel.ir.profiles:PROFILES",
        "archkeel.ir.profiles:UnmeasurableScalar",
        "archkeel.ir.facts_validation:validate_source_facts",
        "archkeel.ir.source_records:RawData",
        "archkeel.ir.source_records:RawRecord",
        "archkeel.ir.source_records:RawEvidence",
        "archkeel.ir.profiles:delta_dimension_applicable",
        "archkeel.ir.source_records:FRAMEWORK_BASES",
        "archkeel.ir.source_records:is_public_method_name",
        "archkeel.ir.architecture_graph:ArchitectureReport",
        "archkeel.ir.graph_codec:report_bytes",
        "archkeel.ir.report_graph:architecture_report"
      ],
      "responsibilities": [
        "Own immutable source facts, protocol values, governance models and pure derivations."
      ],
      "forbidden_responsibilities": [
        "Source parsing, process or filesystem I/O, and workflow orchestration."
      ],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect",
      "inside": "docs/architecture/contracts/ir.json"
    },
    {
      "id": "COMP-CHECK",
      "label": "check",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": [
        "archkeel.check"
      ],
      "namespace": "archkeel.check",
      "requires": [
        {
          "component": "ir",
          "rationale": "Validate source facts, assemble observations and evaluate architecture policy from the shared typed model."
        }
      ],
      "inside": "docs/architecture/contracts/check.json",
      "public": [
        "archkeel.check.git:read_blob",
        "archkeel.check.onboarding:run_init",
        "archkeel.check.ports:Analyzer",
        "archkeel.check.ports:FilesToWrite",
        "archkeel.check.ports:Host",
        "archkeel.check.ports:ScanConfig",
        "archkeel.check.report",
        "archkeel.check.run:run_check",
        "archkeel.check.snapshot:resolve_commit",
        "archkeel.check.validation:invalid_result",
        "archkeel.check.validation:run_validate",
        "archkeel.check.ports:Language",
        "archkeel.check.ports:ObservationResult",
        "archkeel.check.ports:SourceCollector",
        "archkeel.check.observe:Observer",
        "archkeel.check.observation:analyze_source_snapshot"
      ],
      "responsibilities": [
        "Own source-fact validation, observation assembly, architecture rule evaluation and report/check workflows."
      ],
      "forbidden_responsibilities": [
        "Source parsing, process execution, or importing language adapters."
      ],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "COMP-CLI",
      "label": "cli",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": [
        "archkeel.cli"
      ],
      "namespace": "archkeel.cli",
      "requires": [
        {
          "component": "analyzer",
          "rationale": "Supply the concrete source analyzer to report and check workflows."
        },
        {
          "component": "check",
          "rationale": "Invoke deterministic report and check services."
        },
        {
          "component": "host",
          "rationale": "Supply the concrete host-record loader to checks."
        },
        {
          "component": "ir",
          "through": [
            "archkeel.ir.codec"
          ],
          "rationale": "Serialize the typed observation to the legacy JSON payload at the CLI compatibility boundary."
        },
        {
          "component": "render",
          "rationale": "Project typed results and write presentation artifacts."
        }
      ],
      "responsibilities": [
        "Command arguments and configuration; compose the process collector with Core workflows."
      ],
      "forbidden_responsibilities": [],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect",
      "public": []
    },
    {
      "id": "COMP-HOST",
      "label": "host",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": [
        "archkeel.host"
      ],
      "namespace": "archkeel.host",
      "requires": [
        {
          "component": "ir",
          "rationale": "Construct validated host-record values."
        }
      ],
      "public": [
        "archkeel.host.gitlab"
      ],
      "responsibilities": [
        "GitLab host records with SHA, event and timestamp.",
        "Quality goal: replaceable."
      ],
      "forbidden_responsibilities": [],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "COMP-ANALYZER",
      "label": "analyzer",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": [
        "archkeel.analyzer"
      ],
      "namespace": "archkeel.analyzer",
      "requires": [
        {
          "component": "ir",
          "through": [
            "archkeel.ir.facts",
            "archkeel.ir.facts_codec",
            "archkeel.ir.protocol",
            "archkeel.ir.state_facts",
            "archkeel.ir.type_shapes",
            "archkeel.ir.reexports",
            "archkeel.ir.source_records"
          ],
          "rationale": "Adapters publish immutable facts over the shared protocol. Core owns validation, ownership and policy; analyzers do not import it."
        }
      ],
      "inside": "docs/architecture/contracts/analyzer.json",
      "public": [
        "archkeel.analyzer.process:ProcessCollector"
      ],
      "responsibilities": [
        "Run the configured source collector process and keep language parsing and fact collection behind isolated adapters."
      ],
      "forbidden_responsibilities": [
        "Rule evaluation, baselines, ownership, verdicts, and importing sibling language adapters."
      ],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect"
    },
    {
      "id": "COMP-RENDER",
      "label": "render",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": [
        "archkeel.render"
      ],
      "namespace": "archkeel.render",
      "requires": [
        {
          "component": "ir",
          "rationale": "Render typed evidence without importing policy implementations."
        }
      ],
      "public": [
        "archkeel.render.html",
        "archkeel.render.summary:Badge",
        "archkeel.render.summary:VerdictRow",
        "archkeel.render.summary:check_summary",
        "archkeel.render.summary:init_summary",
        "archkeel.render.summary:Summary",
        "archkeel.render.summary:report_summary",
        "archkeel.render.terminal"
      ],
      "responsibilities": [
        "Deterministic HTML and terminal projections of typed Archkeel evidence.",
        "Project As-Is and Target into one render scene and draw their UML notation with one renderer.",
        "Quality goal: replaceable.",
        "Publish the shared graph without reconstructing architecture intent from redundant records."
      ],
      "forbidden_responsibilities": [
        "Architecture decisions and persistence."
      ],
      "provenance": [
        "docs/architecture/archkeel.md"
      ],
      "decided_by": "architect",
      "inside": "docs/architecture/contracts/render.json"
    }
  ],
