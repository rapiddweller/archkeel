{
  "$schema": "https://raw.githubusercontent.com/rapiddweller/archkeel/main/schema/architecture-contract.schema.json",
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "COMP-IR",
      "label": "ir",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.ir"],
      "public": [
        "archkeel.ir.bindings",
        "archkeel.ir.codec",
        "archkeel.ir.decisions",
        "archkeel.ir.digest",
        "archkeel.ir.host_records",
        "archkeel.ir.interfaces",
        "archkeel.ir.lock",
        "archkeel.ir.measurements",
        "archkeel.ir.model",
        "archkeel.ir.references",
        "archkeel.ir.structure",
        "archkeel.ir.trace"
      ],
      "responsibilities": [
        "The shared evidence model, its codecs, and the pure derivations over them, without I/O, that more than one component needs.",
        "Quality goal: deterministic and stable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "COMP-CHECK",
      "label": "check",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.check"],
      "public": [
        "archkeel.check.git:read_blob",
        "archkeel.check.onboarding:run_init",
        "archkeel.check.ports:ScanConfig",
        "archkeel.check.report",
        "archkeel.check.run:run_check",
        "archkeel.check.validation:invalid_result",
        "archkeel.check.validation:run_validate"
      ],
      "responsibilities": [
        "Deterministic deltas, regression checks, expectations and publication-order checks.",
        "Quality goal: deterministic and stable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "COMP-CLI",
      "label": "cli",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.cli"],
      "responsibilities": [
        "Command arguments and archkeel.toml configuration.",
        "Quality goal: a thin composition root."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "COMP-HOST",
      "label": "host",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.host"],
      "public": ["archkeel.host.gitlab"],
      "responsibilities": [
        "GitLab host records with SHA, event and timestamp.",
        "Quality goal: replaceable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "COMP-ANALYZER",
      "label": "analyzer",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.analyzer"],
      "public": ["archkeel.analyzer"],
      "responsibilities": [
        "Run the bundled Python analyzer and preserve typed diagnostics.",
        "Quality goal: isolated; changes independently behind its digest."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "COMP-RENDER",
      "label": "render",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.render"],
      "public": [
        "archkeel.render.html",
        "archkeel.render.summary:check_summary",
        "archkeel.render.summary:init_summary",
        "archkeel.render.summary:report_summary",
        "archkeel.render.terminal"
      ],
      "responsibilities": [
        "Deterministic HTML and terminal projections of typed Archkeel evidence.",
        "Quality goal: replaceable."
      ],
      "forbidden_responsibilities": ["Architecture decisions and persistence."],
      "provenance": ["docs/architecture/archkeel.md"]
    }
  ],
  "declarations": {
    "capabilities": [
      {
        "id": "CAP-ARCHKEEL",
        "name": "ARCHKEEL",
        "label": "Archkeel governance",
        "review_order": 1,
        "provenance": ["docs/architecture/archkeel.md"]
      }
    ],
    "review_scopes": [],
    "public_commands": [],
    "context_roots": [],
    "context_roots_provenance": ["docs/architecture/archkeel.md"],
    "paths": [],
    "spot_owners": []
  },
  "rules": [
    {
      "id": "DEP-IR-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "Stable evidence types remain usable without policy evaluation.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-IR-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Evidence models and codecs remain reusable outside the command line.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-IR-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "Host-independent evidence remains portable across repository providers.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-IR-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "The shared evidence model remains independent of Python source analysis.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CHECK-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Deterministic checks remain callable without command-line orchestration.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CHECK-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "The deterministic core receives host evidence through an injected port.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CHECK-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "The deterministic core receives observations through an injected port.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-NO-IR",
      "kind": "forbidden_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.ir",
      "include_type_checking": true,
      "rationale": "Command services mediate IR access so the CLI only composes workflows.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-HOST-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.host",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "Host adapters collect evidence while check owns policy interpretation.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-HOST-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.host",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Host adapters remain callable without command-line orchestration.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-HOST-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.host",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "Host evidence collection remains independent of source analysis.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "The analyzer produces observations without evaluating policy.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "Source analysis remains callable without command-line orchestration.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "Source analysis remains independent of repository-host APIs.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-BINDINGS",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.bindings",
      "include_type_checking": true,
      "rationale": "The analyzer records the binding signal; the claim built from those records belongs to the reader, so the two never depend on each other.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-DIGEST",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.digest",
      "include_type_checking": true,
      "rationale": "Package identity is checker provenance, so the analyzer must not own package hashing.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-LOCK",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.lock",
      "include_type_checking": true,
      "rationale": "Accepted-state verification belongs to checks while the analyzer only observes source.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-MEASUREMENTS",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.measurements",
      "include_type_checking": true,
      "rationale": "Checks derive regression measurements from observations instead of accepting analyzer policy.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-TRACE",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.trace",
      "include_type_checking": true,
      "rationale": "Checks validate evidence classes while analyzer output stays at the observation boundary.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-HOST-RECORDS",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.host_records",
      "include_type_checking": true,
      "rationale": "The analyzer may publish only the common model and codec boundary.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-INTERFACES",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.interfaces",
      "include_type_checking": true,
      "rationale": "Component communication is derived from observations by render, not built by the analyzer that only observes source.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-REFERENCES",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.references",
      "include_type_checking": true,
      "rationale": "Unreferenced symbols are derived from a finished observation by the report, not decided by the analyzer that only records the reference signal (AD-26).",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-STRUCTURE",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.structure",
      "include_type_checking": true,
      "rationale": "Size and coupling are derived from a finished observation by the report, not measured by the analyzer that only observes source (AD-21).",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-IR-DECISIONS",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.decisions",
      "include_type_checking": true,
      "rationale": "Undecided component pairs are derived from observations by validation and the report, not built by the analyzer that only observes source.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-IR-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.render",
      "include_type_checking": true,
      "rationale": "IR remains independent of presentation.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CHECK-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.check",
      "target": "archkeel.render",
      "include_type_checking": true,
      "rationale": "Checks produce typed results without presentation dependencies.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-HOST-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.host",
      "target": "archkeel.render",
      "include_type_checking": true,
      "rationale": "Host evidence collection remains independent of presentation.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.render",
      "include_type_checking": true,
      "rationale": "The analyzer produces evidence without presentation dependencies.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-CHECK",
      "kind": "forbidden_dependency",
      "source": "archkeel.render",
      "target": "archkeel.check",
      "include_type_checking": true,
      "rationale": "Rendering consumes IR values without check implementation details.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-CLI",
      "kind": "forbidden_dependency",
      "source": "archkeel.render",
      "target": "archkeel.cli",
      "include_type_checking": true,
      "rationale": "The CLI owns presentation output orchestration.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-HOST",
      "kind": "forbidden_dependency",
      "source": "archkeel.render",
      "target": "archkeel.host",
      "include_type_checking": true,
      "rationale": "Rendering consumes typed evidence rather than host implementations.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-NO-ANALYZER",
      "kind": "forbidden_dependency",
      "source": "archkeel.render",
      "target": "archkeel.analyzer",
      "include_type_checking": true,
      "rationale": "Rendering consumes IR values rather than analyzer implementations.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-ANALYZER",
      "kind": "allowed_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.analyzer",
      "rationale": "Supply the concrete source analyzer to report and check workflows.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-CHECK",
      "kind": "allowed_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.check",
      "rationale": "Invoke deterministic report and check services.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-HOST",
      "kind": "allowed_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.host",
      "rationale": "Supply the concrete host-record loader to checks.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CLI-ALLOWS-RENDER",
      "kind": "allowed_dependency",
      "source": "archkeel.cli",
      "target": "archkeel.render",
      "rationale": "Project typed results and write presentation artifacts.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-ANALYZER-ALLOWS-IR",
      "kind": "allowed_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir",
      "rationale": "Publish observations through the common model and codec boundary.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-CHECK-ALLOWS-IR",
      "kind": "allowed_dependency",
      "source": "archkeel.check",
      "target": "archkeel.ir",
      "rationale": "Compare observations and return typed results.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-HOST-ALLOWS-IR",
      "kind": "allowed_dependency",
      "source": "archkeel.host",
      "target": "archkeel.ir",
      "rationale": "Construct validated host-record values.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "DEP-RENDER-ALLOWS-IR",
      "kind": "allowed_dependency",
      "source": "archkeel.render",
      "target": "archkeel.ir",
      "rationale": "Render typed evidence without importing policy implementations.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-DYNAMIC",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["getattr", "hasattr", "cast", "eval", "exec", "dynamic_import", "type_ignore"],
      "rationale": "Static architecture evidence remains explicit and mechanically traceable.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-ASSERT",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["assert"],
      "rationale": "Invariants are checked where values are built, because assert statements vanish under python -O.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-BROAD-EXCEPT",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["broad_except"],
      "allowed_sources": ["archkeel.cli.main"],
      "rationale": "Failures stay typed and visible; only the CLI error boundary turns any failure into an exit-2 result.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-COMPLETE",
      "kind": "complete_external_scope",
      "source": "archkeel",
      "rationale": "A dependency no rule names is a dependency nobody chose, and a package that does not exist looks exactly the same from inside the code.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-PACKAGING-RUNTIME",
      "kind": "external_dependency_scope",
      "dependency": "packaging",
      "allowed_sources": ["archkeel.analyzer.runtime"],
      "rationale": "Only the runtime gate interprets requires-python specifiers; the core stays dependency-free.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-RICH-TERMINAL",
      "kind": "external_dependency_scope",
      "dependency": "rich",
      "allowed_sources": ["archkeel.render.terminal"],
      "rationale": "Terminal styling stays replaceable; JSON and HTML evidence never depend on it.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-RICH-ARGPARSE-CLI",
      "kind": "external_dependency_scope",
      "dependency": "rich_argparse",
      "allowed_sources": ["archkeel.cli"],
      "rationale": "Help formatting belongs to the composition root that owns the argument parser.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "archkeel",
      "rationale": "A module without one owning component escapes every boundary rule.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Components stay layered so each one can be reviewed and replaced in dependency order.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COLLECTORS-ISOLATED",
      "kind": "sibling_isolation",
      "members": [
        "archkeel.analyzer.embedded.calls",
        "archkeel.analyzer.embedded.constructs",
        "archkeel.analyzer.embedded.contexts",
        "archkeel.analyzer.embedded.dependencies",
        "archkeel.analyzer.embedded.imports",
        "archkeel.analyzer.embedded.references",
        "archkeel.analyzer.embedded.symbols",
        "archkeel.analyzer.embedded.typing_signals",
        "archkeel.analyzer.embedded.violations"
      ],
      "rationale": "Collectors are peers behind one scanner (AD-1): each reads parsed sources and writes records, so a collector importing another would create an order between them that the scanner no longer controls.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Components communicate only through declared interfaces, so reaching into another component's internals requires a visible contract change.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    }
  ]
}
