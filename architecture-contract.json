{
  "$schema": "https://raw.githubusercontent.com/rapiddweller/archkeel/main/schema/architecture-contract.schema.json",
  "schema_version": "2.1.0",
  "components": [
    {
      "id": "COMP-IR",
      "label": "ir",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.ir"],
      "public": [
        "archkeel.ir.baseline:KnownViolation",
        "archkeel.ir.baseline:compare_violations",
        "archkeel.ir.baseline:observed_violations",
        "archkeel.ir.baseline:select_violations",
        "archkeel.ir.bindings",
        "archkeel.ir.codec",
        "archkeel.ir.decisions",
        "archkeel.ir.digest",
        "archkeel.ir.duplication",
        "archkeel.ir.host_records",
        "archkeel.ir.interfaces",
        "archkeel.ir.levels:inside_levels",
        "archkeel.ir.lock",
        "archkeel.ir.measurements",
        "archkeel.ir.model",
        "archkeel.ir.references",
        "archkeel.ir.structure",
        "archkeel.ir.trace",
        "archkeel.ir.type_fanin",
        "archkeel.ir.widening"
      ],
      "responsibilities": [
        "The shared evidence model, its codecs, and the pure derivations over them, without I/O, that more than one component needs.",
        "Quality goal: deterministic and stable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMP-CHECK",
      "label": "check",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.check"],
      "requires": [
        {
          "component": "ir",
          "rationale": "Compare observations and return typed results."
        }
      ],
      "inside": "src/archkeel/check/architecture-contract.json",
      "public": [
        "archkeel.check.git:read_blob",
        "archkeel.check.onboarding:run_init",
        "archkeel.check.ports:ScanConfig",
        "archkeel.check.report",
        "archkeel.check.run:run_check",
        "archkeel.check.validation:invalid_result",
        "archkeel.check.validation:run_validate"
      ],
      "responsibilities": [
        "Deterministic deltas, regression checks, expectations and publication-order checks.",
        "Quality goal: deterministic and stable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMP-CLI",
      "label": "cli",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.cli"],
      "requires": [
        {
          "component": "analyzer",
          "rationale": "Supply the concrete source analyzer to report and check workflows."
        },
        {
          "component": "check",
          "rationale": "Invoke deterministic report and check services."
        },
        {
          "component": "host",
          "rationale": "Supply the concrete host-record loader to checks."
        },
        {
          "component": "render",
          "rationale": "Project typed results and write presentation artifacts."
        }
      ],
      "responsibilities": [
        "Command arguments and archkeel.toml configuration.",
        "Quality goal: a thin composition root."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMP-HOST",
      "label": "host",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.host"],
      "requires": [
        {
          "component": "ir",
          "rationale": "Construct validated host-record values."
        }
      ],
      "public": ["archkeel.host.gitlab"],
      "responsibilities": [
        "GitLab host records with SHA, event and timestamp.",
        "Quality goal: replaceable."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMP-ANALYZER",
      "label": "analyzer",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.analyzer"],
      "requires": [
        {
          "component": "ir",
          "through": ["archkeel.ir.model", "archkeel.ir.codec"],
          "rationale": "The analyzer records signals and publishes them through the common model and codec only; every claim, measurement, level or decision built from those records belongs to the reader, so the two never depend on each other (AD-4)."
        }
      ],
      "inside": "src/archkeel/analyzer/architecture-contract.json",
      "public": ["archkeel.analyzer"],
      "responsibilities": [
        "Run the bundled Python analyzer and preserve typed diagnostics.",
        "Quality goal: isolated; changes independently behind its digest."
      ],
      "forbidden_responsibilities": [],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMP-RENDER",
      "label": "render",
      "capability_id": "CAP-ARCHKEEL",
      "role": "component",
      "packages": ["archkeel.render"],
      "requires": [
        {
          "component": "ir",
          "rationale": "Render typed evidence without importing policy implementations."
        }
      ],
      "public": [
        "archkeel.render.html",
        "archkeel.render.summary:check_summary",
        "archkeel.render.summary:init_summary",
        "archkeel.render.summary:report_summary",
        "archkeel.render.terminal"
      ],
      "responsibilities": [
        "Deterministic HTML and terminal projections of typed Archkeel evidence.",
        "Quality goal: replaceable."
      ],
      "forbidden_responsibilities": ["Architecture decisions and persistence."],
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    }
  ],
  "declarations": {
    "capabilities": [
      {
        "id": "CAP-ARCHKEEL",
        "name": "ARCHKEEL",
        "label": "Archkeel governance",
        "review_order": 1,
        "provenance": ["docs/architecture/archkeel.md"]
      }
    ],
    "review_scopes": [],
    "public_commands": [],
    "context_roots": [],
    "context_roots_provenance": ["docs/architecture/archkeel.md"],
    "paths": [],
    "spot_owners": [
      {
        "id": "OWNER-IR-MODEL",
        "label": "Contract and observation vocabulary",
        "owner": "archkeel.ir.model",
        "responsibility": "Rule kinds, record shapes and scope matching stay the single source of truth every component reads.",
        "provenance": ["docs/architecture/archkeel.md"]
      }
    ]
  },
  "rules": [
    {
      "id": "REQUIRES-COMPLETE",
      "kind": "complete_requires",
      "rationale": "A cross-component import the source never asked for is an accident, so a component names what it needs and absence refuses the rest.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-DYNAMIC",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["getattr", "hasattr", "cast", "eval", "exec", "dynamic_import", "type_ignore", "setattr", "delattr", "vars", "dunder_dict"],
      "rationale": "Static architecture evidence remains explicit and mechanically traceable.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-PLACEHOLDER",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["placeholder_body"],
      "rationale": "A function whose body is pass, ellipsis or a lone NotImplementedError reports capability it does not have, and its callers are written against that promise.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-ASSERT",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["assert"],
      "rationale": "Invariants are checked where values are built, because assert statements vanish under python -O.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-BROAD-EXCEPT",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["broad_except"],
      "exact_sources": ["archkeel.cli.main"],
      "rationale": "Failures stay typed and visible; only the CLI error boundary turns any failure into an exit-2 result.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "CONSTRUCT-NO-ANY",
      "kind": "forbidden_construct",
      "source": "archkeel",
      "constructs": ["any_annotation"],
      "allowed_sources": ["archkeel.ir.codec", "archkeel.analyzer.embedded"],
      "rationale": "A typed boundary is the evidence; Any is allowed only where JSON enters, in the codec that decodes it and the collectors that write it (AD-2).",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-COMPLETE",
      "kind": "complete_external_scope",
      "source": "archkeel",
      "rationale": "A dependency no rule names is a dependency nobody chose, and a package that does not exist looks exactly the same from inside the code.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-PACKAGING-RUNTIME",
      "kind": "external_dependency_scope",
      "dependency": "packaging",
      "exact_sources": ["archkeel.analyzer.runtime"],
      "rationale": "Only the runtime gate interprets requires-python specifiers; the core stays dependency-free.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-RICH-TERMINAL",
      "kind": "external_dependency_scope",
      "dependency": "rich",
      "exact_sources": ["archkeel.render.terminal"],
      "rationale": "Terminal styling stays replaceable; JSON and HTML evidence never depend on it.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "EXTERNAL-RICH-ARGPARSE-CLI",
      "kind": "external_dependency_scope",
      "dependency": "rich_argparse",
      "exact_sources": ["archkeel.cli"],
      "rationale": "Help formatting belongs to the composition root that owns the argument parser.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "ASSIGNMENT-COMPLETE",
      "kind": "complete_assignment",
      "source": "archkeel",
      "rationale": "A module without one owning component escapes every boundary rule.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COMPONENT-NO-CYCLES",
      "kind": "no_component_cycles",
      "rationale": "Components stay layered so each one can be reviewed and replaced in dependency order.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "COLLECTORS-ISOLATED",
      "kind": "sibling_isolation",
      "members": [
        "archkeel.analyzer.embedded.bindings",
        "archkeel.analyzer.embedded.calls",
        "archkeel.analyzer.embedded.constructs",
        "archkeel.analyzer.embedded.contexts",
        "archkeel.analyzer.embedded.dependencies",
        "archkeel.analyzer.embedded.imports",
        "archkeel.analyzer.embedded.references",
        "archkeel.analyzer.embedded.symbols",
        "archkeel.analyzer.embedded.typing_signals",
        "archkeel.analyzer.embedded.violations"
      ],
      "rationale": "Collectors are peers behind one scanner (AD-1): each reads parsed sources and writes records, so a collector importing another would create an order between them that the scanner no longer controls.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "INTERFACE-BOUNDARY",
      "kind": "interface_boundary",
      "rationale": "Components communicate only through declared interfaces, so reaching into another component's internals requires a visible contract change.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    },
    {
      "id": "TYPES-ENUM-IN-MODEL",
      "kind": "symbol_placement",
      "source": "archkeel",
      "class_kinds": ["enum"],
      "exact_sources": ["archkeel.ir.model"],
      "rationale": "Every enum Archkeel declares is a term of the contract vocabulary ir.model owns; a second module declaring one would fork that vocabulary.",
      "provenance": ["docs/architecture/archkeel.md"],
      "decided_by": "architect"
    }
  ]
}
