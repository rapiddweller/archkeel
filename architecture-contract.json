    },
    {
      "id": "DEP-ANALYZER-NO-IR-HOST-RECORDS",
      "kind": "forbidden_dependency",
      "source": "archkeel.analyzer",
      "target": "archkeel.ir.host_records",
      "include_type_checking": true,
      "rationale": "The analyzer may publish only the common model and codec boundary.",
      "provenance": ["docs/architecture/archkeel.md"]
    },
    {
      "id": "DEP-IR-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.ir",
      "target": "archkeel.render",
      "include_type_checking": true,
