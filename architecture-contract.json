      "id": "DEP-ACCEPT-NO-RENDER",
      "kind": "forbidden_dependency",
      "source": "archkeel.accept",
      "target": "archkeel.render",
      "include_type_checking": true,
      "rationale": "Acceptance remains independent of presentation.",
