                    },
                    {
                      "$ref": "#/$defs/directExportBinding"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "bindings": {
            "$ref": "urn:archkeel:architecture-ir:decoded:2.0.0#/properties/bindings"
          }
        }
      }
    },
    {
      "$ref": "urn:archkeel:architecture-ir:decoded:2.0.0#/allOf/0"
    },
    {
      "$ref": "urn:archkeel:architecture-ir:decoded:2.0.0#/allOf/1"
    },
    {
      "$ref": "urn:archkeel:architecture-ir:decoded:2.0.0#/allOf/2"
    },
    {
      "$ref": "urn:archkeel:architecture-ir:decoded:2.0.0#/allOf/3"
    },
    {
      "if": {
        "properties": {
          "analyzer": {
            "properties": {
              "name": {
                "const": "archkeel-python-analyzer"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "calls": {
            "$ref": "urn:archkeel:architecture-ir:python-decoded:2.9.0#/properties/calls"
          },
          "symbols": {
            "$ref": "urn:archkeel:architecture-ir:python-decoded:2.9.0#/properties/symbols"
          }
        }
      }
    }
  ],
  "$defs": {
    "directExportBinding": {
      "allOf": [
        {
          "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
        },
        {
          "properties": {
            "evidence_class": {
              "const": "FACT"
            },
            "area": {
              "const": "source"
            },
            "kind": {
              "const": "bindings"
            },
            "evidence_ids": {
              "minItems": 1
            },
            "data": {
              "type": "object",
              "required": [
                "module",
                "source_module",
                "source_scope",
                "name"
              ],
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "source_module": {
                  "type": "string",
                  "minLength": 1
                },
                "source_scope": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          }
        }
      ]
    }
