{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:architecture-contract:2.1.0",
  "title": "Archkeel architecture contract", "description": "Contract 2.1 structure. Rule semantics are cataloged in docs/rules.md.",
  "type": "object",
  "required": ["schema_version", "components", "rules"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"$ref": "#/$defs/nonEmpty"},
    "schema_version": {"const": "2.1.0"},
    "components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/component"}},
    "rules": {"type": "array", "uniqueItems": true, "items": {"oneOf": [
      {"$ref": "#/$defs/forbiddenDependency"}, {"$ref": "#/$defs/allowedDependency"},
      {"$ref": "#/$defs/forbiddenConstruct"},
      {"$ref": "#/$defs/externalDependencyScope"}, {"$ref": "#/$defs/completeAssignment"},
      {"$ref": "#/$defs/rootLayout"},
      {"$ref": "#/$defs/completeExternalScope"}, {"$ref": "#/$defs/completeRequires"},
      {"$ref": "#/$defs/noComponentCycles"}, {"$ref": "#/$defs/interfaceBoundary"},
      {"$ref": "#/$defs/siblingIsolation"}, {"$ref": "#/$defs/symbolPlacement"},
      {"$ref": "#/$defs/boundaryTypes"}
    ]}},
    "declarations": {"$ref": "#/$defs/declarations"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "pattern": "\\S"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "requiredComponent": {
      "type": "object",
      "required": ["component", "rationale"],
      "additionalProperties": false,
      "properties": {
        "component": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "through": {"$ref": "#/$defs/strings"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "component": {
      "type": "object",
      "required": ["id", "label", "role", "packages", "responsibilities", "forbidden_responsibilities", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "label": {"$ref": "#/$defs/nonEmpty"},
        "role": {"enum": ["component", "interface", "contract", "projection", "foundation"]},
        "packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "namespace": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "responsibilities": {"$ref": "#/$defs/strings"},
        "forbidden_responsibilities": {"$ref": "#/$defs/strings"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "capability_id": {"$ref": "#/$defs/nonEmpty"},
        "requires": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/requiredComponent"}},
        "inside": {"$ref": "#/$defs/nonEmpty"},
        "public": {"type": "array", "uniqueItems": true, "items": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(:[A-Za-z_][A-Za-z0-9_]*)?$"
        }},
        "planned": {"type": "array", "uniqueItems": true, "items": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(:[A-Za-z_][A-Za-z0-9_]*)?$"
        }},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "decidedBy": {"enum": ["architect", "agent"]},
    "forbiddenDependency": {
      "type": "object",
      "required": ["id", "kind", "source", "target", "include_type_checking", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"enum": ["forbidden_dependency"]},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "target": {"$ref": "#/$defs/nonEmpty"},
        "include_type_checking": {"type": "boolean"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "target_symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "allowed_sources": {"$ref": "#/$defs/strings"}
      }
    },
    "allowedDependency": {
      "type": "object",
      "required": ["id", "kind", "source", "target", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "allowed_dependency"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "target": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "forbiddenConstruct": {
      "type": "object",
      "required": ["id", "kind", "source", "constructs", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "forbidden_construct"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "constructs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["getattr", "hasattr", "cast", "eval", "exec", "dynamic_import", "type_ignore", "any_annotation", "placeholder_body", "assert", "broad_except", "setattr", "delattr", "vars", "dunder_dict", "string_literal_compare"]
        }},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "allowed_sources": {"$ref": "#/$defs/strings"},
        "exact_sources": {"$ref": "#/$defs/strings"}
      }
    },
    "completeRequires": {
      "type": "object",
      "required": ["id", "kind", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "complete_requires"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "include_type_checking": {"type": "boolean"}
      }
    },
    "completeExternalScope": {
      "type": "object",
      "required": ["id", "kind", "source", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "complete_external_scope"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "externalDependencyScope": {
      "type": "object",
      "required": ["id", "kind", "dependency", "rationale", "provenance", "decided_by"],
      "anyOf": [
        {"required": ["allowed_sources"], "properties": {"allowed_sources": {"minItems": 1}}},
        {"required": ["exact_sources"], "properties": {"exact_sources": {"minItems": 1}}}
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "external_dependency_scope"},
        "dependency": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "allowed_sources": {"$ref": "#/$defs/strings"},
        "exact_sources": {"$ref": "#/$defs/strings"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "completeAssignment": {
      "type": "object",
      "required": ["id", "kind", "source", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "complete_assignment"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "rootLayout": {
      "type": "object",
      "required": ["id", "kind", "root", "allowed_children", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "root_layout"},
        "root": {"$ref": "#/$defs/nonEmpty", "description": "Package or module root whose immediate children are constrained."},
        "allowed_children": {"type": "array", "uniqueItems": true, "description": "Exact names of immediate children of root; each entry must add exactly one name segment.", "items": {"$ref": "#/$defs/nonEmpty"}},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "noComponentCycles": {
      "type": "object",
      "required": ["id", "kind", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "no_component_cycles"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"}
      }
    },
    "interfaceBoundary": {
      "type": "object",
      "required": ["id", "kind", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "interface_boundary"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "include_type_checking": {"type": "boolean"}
      }
    },
    "siblingIsolation": {
      "type": "object",
      "required": ["id", "kind", "members", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "sibling_isolation"},
        "members": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "include_type_checking": {"type": "boolean"}
      }
    },
    "symbolPlacement": {
      "type": "object",
      "required": ["id", "kind", "source", "class_kinds", "rationale", "provenance", "decided_by"],
      "anyOf": [
        {"required": ["allowed_sources"], "properties": {"allowed_sources": {"minItems": 1}}},
        {"required": ["exact_sources"], "properties": {"exact_sources": {"minItems": 1}}}
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "symbol_placement"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "class_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {
          "enum": ["protocol", "enum", "pydantic_model", "dataclass", "class"]
        }},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "allowed_sources": {"$ref": "#/$defs/strings"},
        "exact_sources": {"$ref": "#/$defs/strings"}
      }
    },
    "boundaryTypes": {
      "type": "object",
      "required": ["id", "kind", "source", "rationale", "provenance", "decided_by"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"const": "boundary_types"},
        "source": {"$ref": "#/$defs/nonEmpty"},
        "rationale": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "decided_by": {"$ref": "#/$defs/decidedBy"},
        "allowed_sources": {"$ref": "#/$defs/strings"},
        "exact_sources": {"$ref": "#/$defs/strings"},
        "allowed_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["qualified_name", "position", "field_path", "annotation"],
            "additionalProperties": false,
            "properties": {
              "qualified_name": {"$ref": "#/$defs/nonEmpty"},
              "position": {"$ref": "#/$defs/nonEmpty"},
              "field_path": {"$ref": "#/$defs/nonEmpty"},
              "annotation": {
                "$ref": "#/$defs/nonEmpty",
                "not": {"const": "dict"}
              }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "object",
      "description": "Declarations are documented, public_api is checked for existence (AD-66), and compat is checked for logic-free lifetime-bounded shims (AD-87). See docs/rules.md.",
      "additionalProperties": false,
      "properties": {
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
        "review_scopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reviewScope"}},
        "public_api": {"$ref": "#/$defs/strings"},
        "public_api_provenance": {"$ref": "#/$defs/strings"},
        "public_commands": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/command"}},
        "context_roots": {"$ref": "#/$defs/strings"},
        "context_roots_provenance": {"$ref": "#/$defs/strings"},
        "paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "spot_owners": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/owner"}},
        "compat": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/compatibilityShim"}},
        "measurement_budgets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/measurementBudget"},
          "description": "Deterministic measurement scalars whose accepted values live in the validate baseline."
        }
      }
    },
    "compatibilityShim": {
      "type": "object",
      "required": ["module", "target", "lifetime"],
      "additionalProperties": false,
      "properties": {
        "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "target": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"},
        "lifetime": {"enum": ["permanent", "migration"]}
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "name", "label", "review_order", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "name": {"$ref": "#/$defs/nonEmpty"},
        "label": {"$ref": "#/$defs/nonEmpty"}, "review_order": {"type": "integer", "minimum": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "reviewScope": {
      "type": "object",
      "required": ["id", "label", "parent_id", "subjects", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "label": {"$ref": "#/$defs/nonEmpty"},
        "parent_id": {"$ref": "#/$defs/nonEmpty"},
        "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "command": {
      "type": "object",
      "required": ["id", "command", "description", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "command": {"$ref": "#/$defs/nonEmpty"},
        "description": {"$ref": "#/$defs/nonEmpty"}, "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "path": {
      "type": "object",
      "required": ["id", "label", "kind", "steps", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "label": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"enum": ["read", "write"]},
        "steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "owner": {
      "type": "object",
      "required": ["id", "label", "owner", "responsibility", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonEmpty"}, "label": {"$ref": "#/$defs/nonEmpty"},
        "owner": {"$ref": "#/$defs/nonEmpty"}, "responsibility": {"$ref": "#/$defs/nonEmpty"},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "measurementBudget": {
      "type": "object",
      "required": ["name", "provenance"],
      "additionalProperties": false,
      "properties": {
        "name": {"enum": ["cycle_edges", "private_crossings", "typing_positions", "calls_unresolved", "untyped_private_accesses", "unknown_positions"]},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    }
  }
}
