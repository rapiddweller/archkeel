{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:configuration:1",
  "title": "archkeel.toml configuration (after TOML decoding)",
  "$comment": "Filesystem existence, directory/file types, and containment after symlink resolution require runtime validation.",
  "type": "object",
  "required": [
    "scan"
  ],
  "additionalProperties": false,
  "properties": {
    "scan": {
      "type": "object",
      "required": [
        "roots",
        "namespace",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "description": "Repository-relative source roots, not globs. A dot selects the repository root. Python and Dart roots are directories; TypeScript roots may be files or directories. Runtime validation checks each path."
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(?![\\s\\S])",
          "description": "ASCII dotted package prefix used for internal imports; for Dart, the pubspec name."
        },
        "language": {
          "enum": [
            "python",
            "dart",
            "typescript"
          ],
          "default": "python",
          "description": "Source language. Absent means python (AD-97)."
        },
        "contract": {
          "$ref": "#/$defs/relativePath",
          "not": {
            "const": "."
          },
          "description": "Repository-relative architecture contract file, independent of scan roots."
        },
        "tsconfig": {
          "$ref": "#/$defs/relativePath",
          "not": {
            "const": "."
          },
          "default": "tsconfig.json",
          "description": "Repository-relative TypeScript resolver config."
        },
        "collector_argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]+$"
          },
          "description": "Explicit collector process command."
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tsconfig"
            ]
          },
          "then": {
            "required": [
              "language"
            ],
            "properties": {
              "language": {
                "const": "typescript"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\:*?\\[\\]{}!]+$",
      "description": "POSIX relative path without backslashes, NUL, colon, globs or parent components."
    }
  }
}
