          "$ref": "#/$defs/nonEmpty",
          "description": "A component label with a public list."
        },
        "max_names": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "couplingBudget": {
      "type": "object",
      "required": [
        "source",
        "target",
        "max_names",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/nonEmpty",
          "description": "The importing component label."
        },
        "target": {
          "$ref": "#/$defs/nonEmpty",
          "description": "Another component label with a public list."
        },
        "max_names": {
          "type": "integer",
          "minimum": 0
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "layerOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "layers",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "layer_order"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.1.0"
          }
        }
      },
      "then": {
        "properties": {
          "declarations": {
            "not": {
              "required": [
                "uml"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "2.1.0",
              "2.2.0"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "items": {
              "not": {
                "required": [
                  "layer"
                ]
              }
            }
          },
          "rules": {
            "items": {
              "not": {
                "properties": {
                  "kind": {
                    "const": "layer_order"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
