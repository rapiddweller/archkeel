{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:architecture-contract:2.3.0",
  "title": "Archkeel architecture contract",
  "description": "Contract 2.1.0 / 2.2.0 / 2.3.0 structure. Rule semantics are cataloged in docs/rules.md.",
  "type": "object",
  "required": [
    "schema_version",
    "components",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "$ref": "#/$defs/nonEmpty"
    },
    "schema_version": {
      "enum": [
        "2.1.0",
        "2.2.0",
        "2.3.0"
      ]
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/forbiddenDependency"
          },
          {
            "$ref": "#/$defs/allowedDependency"
          },
          {
            "$ref": "#/$defs/forbiddenConstruct"
          },
          {
            "$ref": "#/$defs/externalDependencyScope"
          },
          {
            "$ref": "#/$defs/completeAssignment"
          },
          {
            "$ref": "#/$defs/rootLayout"
          },
          {
            "$ref": "#/$defs/completeExternalScope"
          },
          {
            "$ref": "#/$defs/completeRequires"
          },
          {
            "$ref": "#/$defs/noComponentCycles"
          },
          {
            "$ref": "#/$defs/interfaceBoundary"
          },
          {
            "$ref": "#/$defs/siblingIsolation"
          },
          {
            "$ref": "#/$defs/symbolPlacement"
          },
          {
            "$ref": "#/$defs/boundaryTypes"
          },
          {
            "$ref": "#/$defs/layerOrder"
          }
        ]
      }
    },
    "declarations": {
      "$ref": "#/$defs/declarations"
    }
  },
  "$defs": {
    "uml": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "urn:archkeel:architecture-target:1.2.0",
      "title": "Independent UML declarations",
      "$comment": "Generated from archkeel.ir.architecture_graph. Reference, identity, evidence and containment checks also require the graph/comparison validators. This graph does not change the Observation wire format.",
      "$ref": "#/$defs/TargetDefinition",
      "$defs": {
        "TargetDefinition": {
          "type": "object",
          "properties": {
            "entities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Entity"
              }
            },
            "relationships": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Relationship"
              }
            },
            "scopes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TargetScope"
              }
            },
            "schema_version": {
              "enum": [
                "1.2.0",
                "1.1.0",
                "1.0.0"
              ]
            }
          },
          "required": [
            "schema_version"
          ],
          "additionalProperties": false
        },
        "Entity": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "component",
                "package",
                "module",
                "class",
                "interface",
                "enum",
                "mixin",
                "enum_literal",
                "method",
                "function",
                "attribute",
                "type_alias",
                "constant",
                "binding",
                "symbol"
              ]
            },
            "qualified_name": {
              "type": "string"
            },
            "language": {
              "type": "string"
            },
            "parent_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "visibility": {
              "$ref": "#/$defs/Visibility"
            },
            "signature": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Signature"
                },
                {
                  "type": "null"
                }
              ]
            },
            "annotation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "modifiers": {
              "type": "array",
              "items": {
                "enum": [
                  "abstract",
                  "static",
                  "class",
                  "async",
                  "frozen",
                  "mixin"
                ]
              }
            },
            "presence": {
              "enum": [
                "defined",
                "referenced",
                "planned",
                "unspecified"
              ]
            },
            "responsibilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provenance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "definition_contexts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/DefinitionContext"
              }
            },
            "initializer": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "file_path": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "qualified_name",
            "language"
          ],
          "additionalProperties": false
        },
        "Visibility": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "public",
                "private",
                "protected",
                "package",
                "unknown"
              ]
            },
            "basis": {
              "enum": [
                "language",
                "convention",
                "declared",
                "unknown"
              ]
            },
            "spelling": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "Signature": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Parameter"
              }
            },
            "returns": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "Parameter": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "annotation": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "enum": [
                "positional_only",
                "positional",
                "keyword_only",
                "varargs",
                "kwargs",
                "unknown"
              ]
            },
            "default": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "default_known": {
              "type": "boolean"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "DefinitionContext": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "if",
                "for",
                "async_for",
                "while",
                "try",
                "try_star",
                "with",
                "async_with",
                "match"
              ]
            },
            "branch": {
              "enum": [
                "body",
                "else",
                "handler",
                "finally",
                "case"
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "kind",
            "branch",
            "evidence_ids"
          ],
          "additionalProperties": false
        },
        "Relationship": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "imports",
                "calls",
                "references",
                "inherits",
                "realizes",
                "mixes_in",
                "creates",
                "instance_of",
                "owns",
                "requires",
                "publishes"
              ]
            },
            "source_id": {
              "type": "string"
            },
            "target_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resolution": {
              "enum": [
                "resolved",
                "partial",
                "unresolved",
                "not_applicable"
              ]
            },
            "candidate_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "expression": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "provenance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "record_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "candidate_count": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "candidates_truncated": {
              "type": "boolean"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "through": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "decided_by": {
              "anyOf": [
                {
                  "enum": [
                    "architect",
                    "agent"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "source_id"
          ],
          "additionalProperties": false
        },
        "TargetScope": {
          "type": "object",
          "properties": {
            "scope_id": {
              "type": "string"
            },
            "mode": {
              "enum": [
                "open",
                "closed"
              ]
            },
            "rationale": {
              "type": "string"
            },
            "provenance": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "entity_kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "component",
                  "package",
                  "module",
                  "class",
                  "interface",
                  "enum",
                  "mixin",
                  "enum_literal",
                  "method",
                  "function",
                  "attribute",
                  "type_alias",
                  "constant",
                  "binding",
                  "symbol"
                ]
              }
            },
            "relationship_kinds": {
              "type": "array",
              "items": {
                "enum": [
                  "imports",
                  "calls",
                  "references",
                  "inherits",
                  "realizes",
                  "mixes_in",
                  "creates",
                  "instance_of",
                  "owns",
                  "requires",
                  "publishes"
                ]
              }
            }
          },
          "required": [
            "scope_id",
            "mode",
            "rationale",
            "provenance"
          ],
          "additionalProperties": false
        }
      }
    },
    "nonEmpty": {
      "type": "string",
      "pattern": "\\S"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmpty"
      }
    },
    "requiredComponent": {
      "type": "object",
      "required": [
        "component",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "through": {
          "$ref": "#/$defs/strings"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "label",
        "role",
        "packages",
        "responsibilities",
        "forbidden_responsibilities",
        "provenance"
      ],
      "anyOf": [
        {
          "properties": {
            "packages": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "exact_modules"
          ],
          "properties": {
            "exact_modules": {
              "minItems": 1
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "role": {
          "enum": [
            "component",
            "interface",
            "contract",
            "projection",
            "foundation"
          ]
        },
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmpty"
          }
        },
        "exact_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "responsibilities": {
          "$ref": "#/$defs/strings"
        },
        "forbidden_responsibilities": {
          "$ref": "#/$defs/strings"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "capability_id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requiredComponent"
          }
        },
        "inside": {
          "$ref": "#/$defs/nonEmpty"
        },
        "public": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(:[A-Za-z_][A-Za-z0-9_]*)?$"
          }
        },
        "planned": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*(:[A-Za-z_][A-Za-z0-9_]*)?$"
          }
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "layer": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "decidedBy": {
      "enum": [
        "architect",
        "agent"
      ]
    },
    "forbiddenDependency": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "include_type_checking",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "enum": [
            "forbidden_dependency"
          ]
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "target": {
          "$ref": "#/$defs/nonEmpty"
        },
        "include_type_checking": {
          "type": "boolean"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "target_symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "allowed_sources": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "allowedDependency": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "allowed_dependency"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "target": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        }
      }
    },
    "forbiddenConstruct": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "constructs",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "forbidden_construct"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "constructs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "getattr",
              "hasattr",
              "cast",
              "eval",
              "exec",
              "dynamic_import",
              "type_ignore",
              "any_annotation",
              "placeholder_body",
              "assert",
              "broad_except",
              "setattr",
              "delattr",
              "vars",
              "dunder_dict",
              "string_literal_compare"
            ]
          }
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "allowed_sources": {
          "$ref": "#/$defs/strings"
        },
        "exact_sources": {
          "$ref": "#/$defs/strings"
        },
        "allowed_type_ignores": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "qualified_name",
              "line",
              "statement",
              "tag"
            ],
            "additionalProperties": false,
            "properties": {
              "qualified_name": {
                "$ref": "#/$defs/nonEmpty"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "statement": {
                "$ref": "#/$defs/nonEmpty"
              },
              "tag": {
                "$ref": "#/$defs/nonEmpty"
              }
            }
          }
        }
      }
    },
    "completeRequires": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "complete_requires"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "include_type_checking": {
          "type": "boolean"
        }
      }
    },
    "completeExternalScope": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "complete_external_scope"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        }
      }
    },
    "externalDependencyScope": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "dependency",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "anyOf": [
        {
          "required": [
            "allowed_sources"
          ],
          "properties": {
            "allowed_sources": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "exact_sources"
          ],
          "properties": {
            "exact_sources": {
              "minItems": 1
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "external_dependency_scope"
        },
        "dependency": {
          "type": "string",
          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*|(?:@[a-z0-9_-]+/)?[a-z0-9][a-z0-9._-]*)$"
        },
        "allowed_sources": {
          "$ref": "#/$defs/strings"
        },
        "exact_sources": {
          "$ref": "#/$defs/strings"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        }
      }
    },
    "completeAssignment": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "complete_assignment"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
