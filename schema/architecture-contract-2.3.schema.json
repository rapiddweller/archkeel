        "class_kinds",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "anyOf": [
        {
          "required": [
            "allowed_sources"
          ],
          "properties": {
            "allowed_sources": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "exact_sources"
          ],
          "properties": {
            "exact_sources": {
              "minItems": 1
            }
          }
        }
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "symbol_placement"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "class_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "protocol",
              "enum",
              "pydantic_model",
              "dataclass",
              "class"
            ]
          }
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "allowed_sources": {
          "$ref": "#/$defs/strings"
        },
        "exact_sources": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "boundaryTypes": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source",
        "rationale",
        "provenance",
        "decided_by"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "kind": {
          "const": "boundary_types"
        },
        "source": {
          "$ref": "#/$defs/nonEmpty"
        },
        "rationale": {
          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "allowed_sources": {
          "$ref": "#/$defs/strings"
        },
        "exact_sources": {
          "$ref": "#/$defs/strings"
        },
        "allowed_positions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "qualified_name",
              "position",
              "annotation"
            ],
            "additionalProperties": false,
            "properties": {
              "qualified_name": {
                "$ref": "#/$defs/nonEmpty"
              },
              "position": {
                "$ref": "#/$defs/nonEmpty"
              },
              "field_path": {
                "anyOf": [
                  {
                    "const": ""
                  },
                  {
                    "$ref": "#/$defs/nonEmpty"
                  }
                ]
              },
              "container_depth": {
                "type": "integer",
                "minimum": 1
              },
              "mapping_depth": {
                "type": "integer",
                "minimum": 1
              },
              "annotation": {
                "$ref": "#/$defs/nonEmpty",
                "not": {
                  "const": "dict"
                }
              }
            },
            "dependentSchemas": {
              "mapping_depth": {
                "properties": {
                  "field_path": {
                    "const": ""
                  }
                }
              }
            },
            "if": {
              "properties": {
                "field_path": {
                  "const": ""
                }
              }
            },
            "then": {
              "properties": {
                "annotation": {
                  "not": {
                    "enum": [
                      "Dict",
                      "Mapping",
                      "MutableMapping"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "declarations": {
      "type": "object",
      "description": "Declarations are documented, public_api is checked for existence (AD-66), compat is checked for logic-free lifetime-bounded shims (AD-87), and facade and coupling budgets are checked against the declared facade measurements (AD-99). See docs/rules.md.",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/capability"
          }
        },
        "review_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reviewScope"
          }
        },
        "public_api": {
          "$ref": "#/$defs/strings"
        },
        "public_api_provenance": {
          "$ref": "#/$defs/strings"
        },
        "public_commands": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/command"
          }
        },
        "context_roots": {
          "$ref": "#/$defs/strings"
        },
        "context_roots_provenance": {
          "$ref": "#/$defs/strings"
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "spot_owners": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/owner"
          }
        },
        "compat": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/compatibilityShim"
          }
        },
        "measurement_budgets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/measurementBudget"
          },
          "description": "Deterministic measurement scalars whose accepted values live in the validate baseline."
        },
        "facade_budgets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/facadeBudget"
          },
          "description": "At most max_names names in one component's declared public facade (AD-99). Raising or removing one is a widening."
        },
        "coupling_budgets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/couplingBudget"
          },
          "description": "At most max_names facade names the source component imports from the target component (AD-99). Raising or removing one is a widening."
        },
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/moduleTarget"
          },
          "description": "Exact source files and their intended responsibilities in this contract level."
        },
        "uml": {
          "$ref": "#/$defs/uml"
        }
      }
    },
    "moduleTarget": {
      "type": "object",
      "required": [
        "path",
        "responsibility"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?![^\\u0000]*\\\\)(?![^\\u0000]*(?:^|/)\\.\\.?/)(?:[^/\\u0000]+/)*[^/\\u0000]+\\.(?:py|dart|ts|tsx|mts|cts|js|jsx|mjs|cjs)(?![\\s\\S])"
        },
        "responsibility": {
          "type": "string",
          "pattern": "^.*\\S.*$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      }
    },
    "compatibilityShim": {
      "type": "object",
      "required": [
        "module",
        "target",
        "lifetime"
      ],
      "additionalProperties": false,
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "lifetime": {
          "enum": [
            "permanent",
            "migration"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "id",
        "name",
        "label",
        "review_order",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmpty"
        },
        "name": {
          "$ref": "#/$defs/nonEmpty"
        },
        "label": {
          "$ref": "#/$defs/nonEmpty"
        },
        "review_order": {
          "type": "integer",
          "minimum": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
