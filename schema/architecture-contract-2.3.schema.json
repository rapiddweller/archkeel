            "untyped_private_accesses",
            "unknown_positions"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "facadeBudget": {
      "type": "object",
      "required": [
        "component",
        "max_names",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
