          "$ref": "#/$defs/nonEmpty"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "decided_by": {
          "$ref": "#/$defs/decidedBy"
        },
        "include_type_checking": {
          "type": "boolean"
        }
      }
    },
