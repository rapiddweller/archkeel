              "minimum": 0
            },
            "crossing_names": {
              "type": "integer",
              "minimum": 0
            },
            "crossing_names_unbound": {
              "type": "integer",
              "minimum": 0
            },
            "undeclared_edges": {
              "type": "integer",
              "minimum": 0
            },
            "unused_edges": {
              "type": "integer",
              "minimum": 0
            },
            "cycles": {
              "type": "integer",
              "minimum": 0
            },
            "unowned_modules": {
              "type": "integer",
              "minimum": 0
            },
            "findings_ranked": {
              "type": "integer",
              "minimum": 0
            },
            "findings_declared": {
              "type": "integer",
              "minimum": 0
            },
            "findings_context": {
              "type": "integer",
              "minimum": 0
            },
            "rules_pass": {
              "type": "integer",
