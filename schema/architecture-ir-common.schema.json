                            }
                          },
                          "candidate_count": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "candidates_truncated": {
                            "type": "boolean"
                          },
                          "reason": {
                            "type": "string"
                          },
                          "target_evidence_ids": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        },
