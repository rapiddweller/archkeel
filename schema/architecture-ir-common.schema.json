                          "expression",
                          "status",
                          "targets",
                          "candidate_count",
                          "candidates_truncated",
                          "reason",
                          "target_evidence_ids"
                        ],
                        "properties": {
                          "source_scope": {
                            "type": "string",
                            "minLength": 1
                          },
                          "source_module": {
                            "type": "string",
                            "minLength": 1
                          },
                          "expression": {
