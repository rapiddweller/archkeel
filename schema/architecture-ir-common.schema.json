{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:architecture-ir:common:1.2.0",
  "title": "Shared ArchitectureIR record and source-evidence definitions",
  "$comment": "DESIGN ARTIFACT. Derived from model.py RECORD_FIELDS/EVIDENCE_FIELDS/EvidenceClass. Cross-record references, ID uniqueness, evidence authenticity, canonical byte encoding and metric arithmetic require code.",
  "$ref": "#/$defs/record",
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "evidence_class",
        "area",
        "kind",
        "title",
        "subjects",
        "evidence_ids",
        "rule_ids",
        "fact_ids",
        "provenance",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "FACT",
            "DECLARED_RULE",
            "VIOLATION",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "object",
          "$comment": "Payload semantics belong to the producer profile. This envelope does not validate architecture meaning."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "DECLARED_RULE"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "VIOLATION"
              }
            }
          },
          "then": {
            "properties": {
              "rule_ids": {
                "minItems": 1
              },
              "fact_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "file",
        "line",
        "end_line",
        "column",
        "excerpt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "description": "0 cites the file itself (AD-107); the if/then below then requires end_line 0, column 0 and an empty excerpt."
        },
        "end_line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "line": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "end_line": {
            "const": 0
          },
          "column": {
            "const": 0
          },
          "excerpt": {
            "const": ""
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "files_discovered",
        "files_read",
        "files_parsed",
        "calls_analyzed",
        "calls_resolved",
        "calls_partially_resolved",
        "calls_unresolved",
        "ast_coverage_percent",
        "call_resolution_percent",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "files_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "files_read": {
          "type": "integer",
          "minimum": 0
        },
        "files_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "calls_analyzed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_resolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_partially_resolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_unresolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ast_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "call_resolution_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "failures": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "rules": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "calls_analyzed": {
              "type": "null"
            },
            "calls_resolved": {
              "type": "null"
            },
            "calls_partially_resolved": {
              "type": "null"
            },
            "calls_unresolved": {
              "type": "null"
            },
            "call_resolution_percent": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "calls_analyzed": {
              "not": {
                "type": "null"
              }
            },
            "calls_resolved": {
              "not": {
                "type": "null"
              }
            },
            "calls_partially_resolved": {
              "not": {
                "type": "null"
              }
            },
            "calls_unresolved": {
              "not": {
                "type": "null"
              }
            },
            "call_resolution_percent": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version",
        "code_digest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "code_digest": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64}|unknown)$"
        }
      },
      "additionalProperties": false
    },
    "pythonImports": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          },
          {
            "properties": {
              "data": {
                "type": "object",
                "required": [
                  "source_module",
                  "source_package",
                  "target_module",
                  "target_package",
                  "binding",
                  "symbol",
                  "relative_level",
                  "under_type_checking",
                  "reexport",
                  "reexport_chain",
                  "origin_definition",
                  "symbol_visibility",
                  "declared_in_all",
                  "symbols_known"
                ],
                "properties": {
                  "source_module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "source_package": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_module": {
                    "type": "string",
                    "minLength": 1
                  },
                  "target_package": {
                    "type": "string",
                    "minLength": 1
                  },
                  "binding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "relative_level": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "under_type_checking": {
                    "type": "boolean"
                  },
                  "reexport": {
                    "type": "boolean"
                  },
                  "reexport_chain": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "origin_definition": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "symbol_visibility": {
                    "enum": [
                      "private",
                      "public_name",
                      null
                    ]
                  },
                  "declared_in_all": {
                    "type": "boolean"
                  },
                  "source_binding_unique": {
                    "type": "boolean",
                    "description": "True when this publisher binding has one module-scope binder; false means a competing binder prevents unique publication evidence."
                  },
                  "symbols_known": {
                    "type": "boolean",
                    "description": "False when the import names no symbol, so which names cross is unknown (a Dart import without show, AD-97)."
                  },
                  "reexport_candidates": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "source_member_binding_static": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        ]
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "schema_version",
        "analyzer",
        "source",
        "contract",
        "coverage",
        "metrics",
        "declarations",
        "scope_observations",
        "packages",
        "modules",
        "symbols",
        "imports",
        "dependency_edges",
        "transitive_paths",
        "path_observations",
        "cycles",
        "calls",
        "references",
        "bindings",
        "typing_signals",
        "constructs",
        "contexts",
        "context_evidence",
        "violations",
        "unknowns",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "1.3.0"
        },
        "analyzer": {
          "type": "object",
          "required": [
            "name",
            "version",
            "code_digest"
          ],
          "properties": {
            "name": {
              "enum": [
                "archkeel-python-analyzer",
                "archkeel-dart-directives",
                "archkeel-typescript-imports"
              ]
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "code_digest": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{64}|unknown)$"
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "required": [
            "git_head",
            "dirty",
            "source_digest",
            "scope"
          ],
          "properties": {
            "git_head": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|unknown)$"
            },
            "dirty": {
              "type": [
                "boolean",
                "string"
              ],
              "enum": [
                true,
                false,
                "unknown"
              ]
            },
            "source_digest": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{64}|unknown)$"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "contract": {
          "type": "object",
          "required": [
            "schema_version",
            "digest",
            "path"
          ],
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{64}|unknown)$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "coverage": {
          "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/coverage"
        },
        "metrics": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "declarations": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "scope_observations": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "packages": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "symbols": {
          "anyOf": [
            {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "allOf": [
                  {
                    "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
                  },
                  {
                    "not": {
                      "properties": {
                        "evidence_class": {
                          "const": "HYPOTHESIS"
                        }
                      },
                      "required": [
                        "evidence_class"
                      ]
                    }
                  }
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "imports": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "dependency_edges": {
          "type": "array",
          "items": {
            "allOf": [
              {
