{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:architecture-ir:common:1.2.0",
  "title": "Shared ArchitectureIR record and source-evidence definitions",
  "$comment": "DESIGN ARTIFACT. Derived from model.py RECORD_FIELDS/EVIDENCE_FIELDS/EvidenceClass. Cross-record references, ID uniqueness, evidence authenticity, canonical byte encoding and metric arithmetic require code.",
  "$ref": "#/$defs/record",
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "evidence_class",
        "area",
        "kind",
        "title",
        "subjects",
        "evidence_ids",
        "rule_ids",
        "fact_ids",
        "provenance",
        "data"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "FACT",
            "DECLARED_RULE",
            "VIOLATION",
            "HYPOTHESIS",
            "UNKNOWN"
          ]
        },
        "area": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data": {
          "type": "object",
          "$comment": "Payload semantics belong to the producer profile. This envelope does not validate architecture meaning."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "DECLARED_RULE"
              }
            }
          },
          "then": {
            "properties": {
              "provenance": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "evidence_class": {
                "const": "VIOLATION"
              }
            }
          },
          "then": {
            "properties": {
              "rule_ids": {
                "minItems": 1
              },
              "fact_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "file",
        "line",
        "end_line",
        "column",
        "excerpt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 0,
          "description": "0 cites the file itself (AD-107); the if/then below then requires end_line 0, column 0 and an empty excerpt."
        },
        "end_line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "excerpt": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "line": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "end_line": {
            "const": 0
          },
          "column": {
            "const": 0
          },
          "excerpt": {
            "const": ""
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "status",
        "files_discovered",
        "files_read",
        "files_parsed",
        "calls_analyzed",
        "calls_resolved",
        "calls_partially_resolved",
        "calls_unresolved",
        "ast_coverage_percent",
        "call_resolution_percent",
        "failures"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "files_discovered": {
          "type": "integer",
          "minimum": 0
        },
        "files_read": {
          "type": "integer",
          "minimum": 0
        },
        "files_parsed": {
          "type": "integer",
          "minimum": 0
        },
        "calls_analyzed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_resolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_partially_resolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "calls_unresolved": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ast_coverage_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "call_resolution_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "failures": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
              },
              {
                "not": {
                  "properties": {
                    "evidence_class": {
                      "const": "HYPOTHESIS"
                    }
                  },
                  "required": [
                    "evidence_class"
                  ]
                }
              }
            ]
          }
        },
        "rules": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "calls_analyzed": {
              "type": "null"
            },
            "calls_resolved": {
              "type": "null"
            },
            "calls_partially_resolved": {
              "type": "null"
            },
            "calls_unresolved": {
              "type": "null"
            },
            "call_resolution_percent": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "calls_analyzed": {
              "not": {
                "type": "null"
              }
            },
            "calls_resolved": {
              "not": {
                "type": "null"
              }
            },
            "calls_partially_resolved": {
              "not": {
                "type": "null"
              }
            },
            "calls_unresolved": {
              "not": {
                "type": "null"
              }
            },
            "call_resolution_percent": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
