{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:architecture-command:1.0.0",
  "title": "Focused architecture command",
  "$comment": "Default fields may be omitted. Selector names starting with dot or colon (or empty) are relative to selector_prefix, falling back to namespace. Public/planned group selectors by module, with symbol names or empty for the whole module. Module paths are relative to component.path; empty means that exact file. Required summaries group only internal class/method/type relationships by authenticated scope, kind, Core status and exact reasons; cross-component and interface relationships remain individual. Permission rule_ids exclude requires IDs already carried by the same component: allowed pairs restore those IDs by matching requires.target_id. Requires observed_imports count component-pair sites, not narrower through compliance. Numeric reasons index reasons. UNKNOWN rows [scopes, count] account for every uncertainty exactly once; empty scopes are global or unattributed. Permission rules carry original authenticated Core declarations and assessments. Allowed is a declared conditional permission, not permission for each import. Policy context retains ancestor levels/rules and peer ownership/public/planned selectors. Coverage and Core verdicts remain global under component filters.",
  "$ref": "#/$defs/ArchitectureCommandEnvelope",
  "$defs": {
    "ArchitectureCommandEnvelope": {
      "type": "object",
      "properties": {
        "exit_code": {
          "enum": [
            0,
            1,
            2
          ]
        },
        "observation_complete": {
          "enum": [
            "PASS",
            "UNKNOWN"
          ]
        },
        "declared_rules": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "coverage": {
          "anyOf": [
            {
              "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/coverage"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "urn:archkeel:command-result:5.0.0#/$defs/diagnostic"
          }
        },
        "report_filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportFilter"
            },
            {
              "type": "null"
            }
          ]
        },
        "architecture_projection": {
          "$ref": "#/$defs/ArchitectureCommandView"
        },
        "filtered_violations": {
          "type": "array",
          "items": {
            "$ref": "urn:archkeel:command-result:5.0.0#/$defs/filteredViolation"
          }
        },
        "command": {
          "enum": [
            "report"
          ]
        },
        "expectation_fulfilled": {
          "enum": [
            "n/a"
          ]
        },
        "schema_version": {
          "enum": [
            "1.0.0"
          ]
        }
      },
      "required": [
        "exit_code",
        "observation_complete",
        "declared_rules",
        "coverage",
        "diagnostics",
        "report_filter",
        "architecture_projection",
        "filtered_violations",
        "schema_version"
      ],
      "additionalProperties": false
    },
    "ReportFilter": {
      "type": "object",
      "properties": {
        "only_violations": {
          "type": "boolean"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "only_calls": {
          "type": "boolean"
        },
        "only_architecture": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "ArchitectureCommandView": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/SourceInfo"
        },
        "contract_digest": {
          "type": "string"
        },
        "analyzer_digest": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArchitectureComponentView"
          }
        },
        "policy_context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionContextView"
          }
        },
        "levels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LevelProjection"
          }
        },
        "permission_rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionRuleProjection"
          }
        },
        "required_relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredRelationshipProjection"
          }
        },
        "required_summaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiredRelationshipSummary"
          }
        },
        "ownership_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OwnershipGap"
          }
        },
        "unknowns": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "integer"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "reason": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "violation_remedy": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "contract_digest",
        "analyzer_digest",
        "components",
        "policy_context",
        "levels",
        "permission_rules",
        "required_relationships",
        "required_summaries",
        "ownership_gaps",
        "unknowns",
        "status",
        "reason",
        "reasons",
        "violation_remedy"
      ],
      "additionalProperties": false
    },
    "SourceInfo": {
      "type": "object",
      "properties": {
        "git_head": {
          "type": "string"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "unknown"
              ]
            }
          ]
        },
        "source_digest": {
          "type": "string"
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "git_head",
        "dirty",
        "source_digest",
        "scope"
      ],
      "additionalProperties": false
    },
    "ArchitectureComponentView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "items": {
