        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "internal_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "source_id",
        "source",
        "target_id",
        "target",
        "status",
        "reasons"
      ],
      "additionalProperties": false
    },
    "RequiredRelationshipSummary": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "imports",
            "calls",
            "references",
            "inherits",
            "realizes",
            "creates",
            "instance_of",
            "owns",
            "requires",
            "publishes"
          ]
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "scope",
        "kind",
        "status",
        "reasons",
        "count"
      ],
      "additionalProperties": false
    },
    "OwnershipGap": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "module",
        "path",
        "candidate_ids",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
