        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "enum": [
            "component",
            "interface",
            "contract",
            "projection",
            "foundation"
          ]
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "selector_prefix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "planned": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "modules": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiresProjection"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionGroup"
          }
        },
        "used_by": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "scope",
        "path",
        "provenance",
        "packages",
        "responsibilities",
        "not_responsible_for",
        "status",
        "reason",
        "decided_by"
      ],
      "additionalProperties": false
    },
    "RequiresProjection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "target_id": {
          "type": "string"
        },
        "through": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "decided_by": {
          "anyOf": [
            {
              "enum": [
                "architect",
                "agent"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_imports": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "target_id",
        "through",
        "rationale",
        "decided_by",
        "observed_imports"
      ],
      "additionalProperties": false
    },
    "PermissionGroup": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "allowed",
            "forbidden",
            "undecided"
          ]
        },
        "reason": {
          "type": "integer"
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "reason",
        "target_ids"
      ],
      "additionalProperties": false
    },
    "PermissionContextView": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exact_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiresProjection"
          }
        },
        "permissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PermissionGroup"
          }
        },
        "public": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "planned": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "scope",
        "parent_id",
        "packages",
        "exact_modules",
        "requires",
        "permissions",
        "public",
        "planned"
      ],
      "additionalProperties": false
    },
    "LevelProjection": {
      "type": "object",
      "properties": {
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "component_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declared": {
          "type": "integer"
        },
        "used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "unused": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "undeclared": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "undecided": {
          "type": "integer"
        },
        "unowned_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "parent_id",
        "component_ids",
        "declared",
        "used",
        "unused",
        "undeclared",
        "undecided",
        "unowned_modules"
      ],
      "additionalProperties": false
    },
    "PermissionRuleProjection": {
      "type": "object",
      "properties": {
        "declaration": {
          "$ref": "urn:archkeel:architecture-ir:common:1.2.0#/$defs/record"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleAssessment"
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "declaration",
        "assessment"
      ],
      "additionalProperties": false
