{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:view-spec:1.2.0",
  "title": "Checked view spec",
  "$comment": "Generated from archkeel.ir.view_spec (AD-284). The spec cannot state proof: `archkeel view check` assigns proven, declared, unknown or missing; claim is author text. Edge, step and stop nodes must be listed in nodes; the first step takes no kind or claim. A stop is author text beside measured facts; it needs schema_version 1.1.0 (AD-289). A story, and the step fields chapter, title, question and external, need 1.2.0 (AD-291); the step note is the story text.",
  "$ref": "#/$defs/ViewSpec",
  "$defs": {
    "ViewSpec": {
      "type": "object",
      "properties": {
        "schema_version": {
          "enum": [
            "1.2.0",
            "1.1.0",
            "1.0.0"
          ]
        },
        "title": {
          "type": "string"
        },
        "snapshot": {
          "$ref": "#/$defs/ViewSnapshot"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewEdge"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewStep"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewStop"
          }
        },
        "story": {
          "anyOf": [
            {
              "$ref": "#/$defs/ViewStory"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schema_version",
        "title",
        "snapshot",
        "nodes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": "1.0.0"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "stops"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "enum": [
                  "1.0.0",
                  "1.1.0"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "story"
              ]
            },
            "properties": {
              "steps": {
                "items": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "chapter"
                        ]
                      },
                      {
                        "required": [
                          "title"
                        ]
                      },
                      {
                        "required": [
                          "question"
                        ]
                      },
                      {
                        "required": [
                          "external"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    },
    "ViewSnapshot": {
      "type": "object",
      "properties": {
        "source_digest": {
          "type": "string"
        },
        "contract_digest": {
          "type": "string"
        }
      },
      "required": [
        "source_digest",
        "contract_digest"
      ],
      "additionalProperties": false
    },
    "ViewEdge": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "imports",
                "calls",
                "references",
                "inherits",
                "realizes",
                "mixes_in",
                "creates",
                "instance_of",
                "owns",
                "requires",
                "publishes"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "type": "boolean"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "ViewStep": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "enum": [
                "imports",
                "calls",
                "references",
                "inherits",
                "realizes",
                "mixes_in",
                "creates",
                "instance_of",
                "owns",
                "requires",
                "publishes"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "claim": {
          "type": "boolean"
        },
        "chapter": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "external": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewExternal"
          }
        }
      },
      "required": [
        "node"
      ],
      "additionalProperties": false
    },
    "ViewExternal": {
      "type": "object",
      "properties": {
        "system": {
          "enum": [
            "redis",
            "relational_database",
            "mongodb",
            "object_storage",
            "kafka",
            "rabbitmq"
          ]
        },
        "direction": {
          "enum": [
            "reads",
            "writes",
            "reads_writes",
            "touches"
          ]
        }
      },
      "required": [
        "system",
        "direction"
      ],
      "additionalProperties": false
    },
    "ViewStop": {
      "type": "object",
      "properties": {
        "node": {
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node"
      ],
      "additionalProperties": false
    },
    "ViewStory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ViewChapter"
          }
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "ViewChapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    }
  }
}
