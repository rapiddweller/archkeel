        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "definition_contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DefinitionContext"
          }
        },
        "initializer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
