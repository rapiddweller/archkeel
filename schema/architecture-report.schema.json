        },
        "public_api": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PublicAPIEntry"
          }
        },
        "external_scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalDependencyScopeRule"
          }
        }
