      "type": "object",
      "properties": {
        "observed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchitectureGraph"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArchitectureGraph"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphComparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "unavailable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "enum": [
            "1.0.0"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportFinding"
          }
        },
        "memberships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentMembership"
          }
