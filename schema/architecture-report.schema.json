        "decision_gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DependencyDecisionGap"
          }
        }
      },
      "required": [
        "observed",
        "target",
        "schema_version"
      ],
      "additionalProperties": false
    },
