{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "archkeel collection request",
  "description": "The request of a native collector. Generated from the Rust types.",
  "$ref": "#/$defs/Request",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/Version",
          "description": "The protocol version that the reply must use."
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot",
          "description": "The tree that the collector reads."
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "The files that the collector reads."
        },
        "resolver": {
          "$ref": "#/$defs/Resolver",
          "description": "The resolver settings of the language."
        }
      },
      "required": [
        "protocol_version",
        "snapshot",
        "scope",
        "resolver"
      ],
      "description": "One collection request. `R` is the settings of the language: the whole `Resolver` as the wire\nhas it, or the settings of one language after the collector has chosen it.",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol_version": {
                "enum": [
                  "9.0.0",
                  "10.0.0"
                ]
              }
            },
            "required": [
              "protocol_version"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "required": [
                  "exclude_test_sources"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "not": {
                  "required": [
                    "exclude_test_sources"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_version": {
                "enum": [
                  "10.0.0"
                ]
              }
            },
            "required": [
              "protocol_version"
            ]
          },
          "then": {
            "properties": {
              "resolver": {
                "properties": {
                  "language": {
                    "const": "python"
                  }
                },
                "required": [
                  "language"
                ]
              }
            }
          },
          "else": {
            "not": {
              "properties": {
                "resolver": {
                  "properties": {
                    "language": {
                      "const": "python"
                    }
                  },
                  "required": [
                    "language"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "Version": {
      "oneOf": [
        {
          "type": "string",
          "const": "3.0.0",
          "description": "Protocol 3, the oldest request."
        },
        {
          "type": "string",
          "const": "8.0.0",
          "description": "Protocol 8."
        },
        {
          "type": "string",
          "const": "9.0.0",
          "description": "Protocol 9: the scope can exclude test sources."
        },
        {
          "type": "string",
          "const": "10.0.0",
          "description": "Protocol 10: the request of the native Python collector."
        }
      ],
      "description": "A request version that the host sends to a native collector."
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "The absolute snapshot root."
        },
        "git_head": {
          "type": "string",
          "description": "The commit that the tree is at."
        },
        "dirty": {
          "$ref": "#/$defs/Dirty",
          "description": "`true`, `false` or `\"unknown\"`, echoed back in the reply."
        }
      },
      "required": [
        "root",
        "git_head",
        "dirty"
      ],
      "description": "The snapshot to read."
    },
    "Dirty": {
      "anyOf": [
        {
          "type": "boolean",
          "description": "Whether the tree has uncommitted changes."
        },
        {
          "$ref": "#/$defs/UnknownDirty",
          "description": "The tool could not tell."
        }
      ],
      "description": "`dirty` is a Boolean, or the text `unknown` when the host could not read the work tree."
    },
    "UnknownDirty": {
      "oneOf": [
        {
          "type": "string",
          "const": "unknown",
          "description": "The tool could not tell whether the tree is dirty."
        }
      ],
      "description": "The value of `dirty` when the tool cannot tell."
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nonempty relative paths that stay inside the snapshot and neither repeat nor overlap."
        },
        "namespace": {
          "type": "string",
          "description": "A dotted namespace."
        },
        "exclude_test_sources": {
          "type": "boolean",
          "description": "Present exactly in a 9.0.0 request (AD-313)."
        }
      },
      "required": [
        "roots",
        "namespace"
      ],
      "description": "The part of the snapshot to read."
    },
    "Resolver": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "const": "typescript"
            },
            "tsconfig": {
              "type": "string",
              "description": "A relative path that stays inside the snapshot."
            },
            "bundler": {
              "const": true,
              "description": "The host writes `bundler` only when it is true, so false has one form: absent."
            },
            "browser": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrowserSettings"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The browser entry of the part (AD-1420): the page whose scripts are the browser code."
            }
          },
          "required": [
            "language",
            "tsconfig"
          ],
          "description": "The settings of the TypeScript resolver."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The settings of the Rust resolver.",
          "properties": {
            "language": {
              "type": "string",
              "const": "rust"
            }
          },
          "required": [
            "language"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "const": "python"
            },
            "phase": {
              "$ref": "#/$defs/PythonPhase",
              "description": "The phase of the Python collection."
            },
            "import_roots_ambiguous": {
              "const": true,
              "description": "Conflicting build metadata leaves the runtime import roots unknown."
            },
            "python": {
              "type": [
                "string",
                "null"
              ],
              "description": "The configured target version, when the scan names one."
            },
            "interpreter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Interpreter"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A legacy interpreter description from an older caller."
            }
          },
          "required": [
            "language",
            "phase"
          ],
          "description": "The settings of the Python resolver."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The settings of the Dart resolver.",
          "properties": {
            "language": {
              "type": "string",
              "const": "dart"
            }
          },
          "required": [
            "language"
          ]
        }
      ],
      "description": "The settings of one language. The tag is the language that the collector reads."
    },
    "BrowserSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "description": "A relative path of an HTML file inside the snapshot."
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nonempty relative folders inside the snapshot, searched in order for a `src` path."
        }
      },
      "required": [
        "entry",
        "assets"
      ],
      "description": "The page that a part ships to a browser, and the folders that serve its `src` paths."
    },
    "PythonPhase": {
      "oneOf": [
        {
          "type": "string",
          "const": "imports",
          "description": "The import survey."
        }
      ],
      "description": "The part of the Python collection that the request asks for. Slice 1 has the import survey."
    },
    "Interpreter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "`platform.python_version()`, for example `3.11.12`: the version that the facts claim."
        },
        "stdlib_module_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`sys.stdlib_module_names`, sorted."
        },
        "builtin_module_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`sys.builtin_module_names`, sorted. The set depends on the build, not on the version."
        }
      },
      "required": [
        "version",
        "stdlib_module_names",
        "builtin_module_names"
      ],
      "description": "What the host interpreter is, as one isolated child (`python -I`) sees it. The host builds it\nin one function (`analyzer/interpreter.py`); the collector reads it and never runs Python."
    }
  }
}
