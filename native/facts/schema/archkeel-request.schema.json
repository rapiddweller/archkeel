{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "archkeel collection request",
  "description": "The request of a native collector. Generated from the Rust types.",
  "$ref": "#/$defs/Request",
  "$defs": {
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "$ref": "#/$defs/Version"
        },
        "snapshot": {
          "$ref": "#/$defs/Snapshot"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "resolver": {
          "$ref": "#/$defs/Resolver"
        }
      },
      "required": [
        "protocol_version",
        "snapshot",
        "scope",
        "resolver"
      ],
      "description": "One collection request. `R` is the settings of the language: the whole `Resolver` as the wire\nhas it, or the settings of one language after the collector has chosen it.",
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol_version": {
                "enum": [
                  "9.0.0",
                  "10.0.0"
                ]
              }
            },
            "required": [
              "protocol_version"
            ]
          },
          "then": {
            "properties": {
              "scope": {
                "required": [
                  "exclude_test_sources"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "scope": {
                "not": {
                  "required": [
                    "exclude_test_sources"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol_version": {
                "enum": [
                  "10.0.0"
                ]
              }
            },
            "required": [
              "protocol_version"
            ]
          },
          "then": {
            "properties": {
              "resolver": {
                "properties": {
                  "language": {
                    "const": "python"
                  }
                },
                "required": [
                  "language"
                ]
              }
            }
          },
          "else": {
            "not": {
              "properties": {
                "resolver": {
                  "properties": {
                    "language": {
                      "const": "python"
                    }
                  },
                  "required": [
                    "language"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "Version": {
      "type": "string",
      "enum": [
        "3.0.0",
        "8.0.0",
        "9.0.0",
        "10.0.0"
      ],
      "description": "A request version that the host sends to a native collector."
    },
    "Snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "description": "The absolute snapshot root."
        },
        "git_head": {
          "type": "string"
        },
        "dirty": {
          "$ref": "#/$defs/Dirty",
          "description": "`true`, `false` or `\"unknown\"`, echoed back in the reply."
        }
      },
      "required": [
        "root",
        "git_head",
        "dirty"
      ],
      "description": "The snapshot to read."
    },
    "Dirty": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/UnknownDirty"
        }
      ],
      "description": "`dirty` is a Boolean, or the text `unknown` when the host could not read the work tree."
    },
    "UnknownDirty": {
      "type": "string",
      "enum": [
        "unknown"
      ]
    },
    "Scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Nonempty relative paths that stay inside the snapshot and neither repeat nor overlap."
        },
        "namespace": {
          "type": "string",
          "description": "A dotted namespace."
        },
        "exclude_test_sources": {
          "type": "boolean",
          "description": "Present exactly in a 9.0.0 request (AD-313)."
        }
      },
      "required": [
        "roots",
        "namespace"
      ],
      "description": "The part of the snapshot to read."
    },
    "Resolver": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "const": "typescript"
            },
            "tsconfig": {
              "type": "string",
              "description": "A relative path that stays inside the snapshot."
            },
            "bundler": {
              "const": true,
              "description": "The host writes `bundler` only when it is true, so false has one form: absent."
            }
          },
          "required": [
            "language",
            "tsconfig"
          ],
          "description": "The settings of the TypeScript collector."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The Rust collector has no settings: its resolver is `{\"language\": \"rust\"}`.",
          "properties": {
            "language": {
              "type": "string",
              "const": "rust"
            }
          },
          "required": [
            "language"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "language": {
              "type": "string",
              "const": "python"
            },
            "phase": {
              "$ref": "#/$defs/PythonPhase"
            },
            "interpreter": {
              "$ref": "#/$defs/Interpreter"
            }
          },
          "required": [
            "language",
            "phase",
            "interpreter"
          ],
          "description": "The settings of the Python collector (AD-334). Only protocol 10.0.0 carries them."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "The Dart collector has no settings: its resolver is `{\"language\": \"dart\"}`, as\n`ir/protocol.DartSettings` writes it. Protocol 10.0.0 stays Python only (AD-334, AD-368).",
          "properties": {
            "language": {
              "type": "string",
              "const": "dart"
            }
          },
          "required": [
            "language"
          ]
        }
      ],
      "description": "The settings of one language. The tag is the language that the collector reads."
    },
    "PythonPhase": {
      "type": "string",
      "enum": [
        "imports"
      ],
      "description": "The part of the Python collection that the request asks for. Slice 1 has the import survey."
    },
    "Interpreter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "description": "`platform.python_version()`, for example `3.11.12`: the version that the facts claim."
        },
        "stdlib_module_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`sys.stdlib_module_names`, sorted."
        },
        "builtin_module_names": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "`sys.builtin_module_names`, sorted. The set depends on the build, not on the version."
        }
      },
      "required": [
        "version",
        "stdlib_module_names",
        "builtin_module_names"
      ],
      "description": "What the host interpreter is, as one isolated child (`python -I`) sees it. The host builds it\nin one function (`analyzer/interpreter.py`); the collector reads it and never runs Python."
    }
  }
}
